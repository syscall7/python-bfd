{% load staticfiles %}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/html" xmlns="http://www.w3.org/1999/html" ng-app="odaApp">
<head>

    <title>{%  block title %}ODA - The Online Disassembler{% endblock %}</title>
    <link rel="icon" type="image/png" href="{% static 'images/oda.png' %}" />

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.0.3/css/bootstrap.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.0.3/css/bootstrap-theme.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/font-awesome-4.0.3/css/font-awesome.css' %}" />

    <link rel="stylesheet" type="text/css" media="all" href="https://code.jquery.com/ui/1.10.0/themes/base/jquery-ui.css" />
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-notify/bootstrap-notify.css' %}" />

    <link rel="stylesheet" type="text/css" href="{% static 'css/oda2.css' %}" />


    {% load compress %}
    {% compress js %}
    <script type="text/javascript" src="{% static 'scripts/lib/jquery/jquery-1.8.3.min.js' %}" ></script>
    <script type="text/javascript" src="{% static 'scripts/lib/bootstrap-3.0.3/js/bootstrap.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular-sanitize.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-plugins/ui-utils-0.1.0/modules/keypress/keypress.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-plugins/ui-utils-0.1.0/modules/event/event.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/bootstrap-notify/bootstrap-notify.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/underscore-1.3.3.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/backbone-0.9.2.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/splitter.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/socket.io.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/scroll-startstop.events.jquery.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/deprecated/fixed-table.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/deprecated/history.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/deprecated/hex-handler.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery.form.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery.visible.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/keypress-2.0.1.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/deprecated/app.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/deprecated/live-hex.js' %}"></script>

    <script type="text/javascript" src="{% static 'scripts/addrbar.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/deprecated/socket.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/deprecated/oda_application.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/deprecated/directives.js' %}"></script>

    <script type="text/javascript" src="{% static 'scripts/controllers/../static/scripts/deprecated/controllers/HexController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/../static/scripts/deprecated/controllers/DisassemblyController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/StringsController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/SectionsController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/../static/scripts/deprecated/controllers/SliderController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/LiveEntryController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/../static/scripts/deprecated/controllers/SidebarToolbarController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/../static/scripts/deprecated/controllers/StatusController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/../static/scripts/deprecated/controllers/SymbolsController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/OptionsViewController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/../static/scripts/deprecated/controllers/EditMenuController.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/controllers/../static/scripts/deprecated/controllers/FindBytesController.js' %}"></script>

    {%  endcompress %}
    <script src="https://code.jquery.com/ui/1.10.0/jquery-ui.js"></script>

    {% block head %}{% endblock %}

</head>
<body style="overflow: hidden;">

<div class='notifications top-right'></div>

{% include 'navbar.djhtml' %}

<div id="open-modal" class="modal hide fade"></div>

{% include "modal-share.djhtml" %}

{% include "modal-whats-oda.djhtml" %}

{% include "modal-about.djhtml" %}

{% include "modal-platform-options.djhtml" %}

{% include "modal-open.djhtml" %}

{% include "popover-inst-doc.djhtml" %}

<div id="main-display">
    {% block content %}{% endblock %}

</div>

    <script type="text/javascript">

	    var _gaq = _gaq || [];
	    _gaq.push(['_setAccount', 'UA-25987200-1']);
	    _gaq.push(['_trackPageview']);

	    (function() {
	        var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;
	        ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';
	        var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);
	    })();

	</script>


    <script type="text/javascript">
         /*
         {%  for sql in sql_queries %}
            console.log("{{  sql.sql }}");
          {%  endfor  %}
          */
    </script>

</body>
</html>