    <link rel="stylesheet" type="text/css" media="all" href="{{ STATIC_URL }}css/bootstrap-responsive.min.css" />
    <link rel="stylesheet" type="text/css" media="all" href="http://code.jquery.com/ui/1.10.0/themes/base/jquery-ui.css" />
    <link rel="stylesheet" type="text/css" media="all" href="{{ STATIC_URL }}css/oda.css"  />


    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/jquery-1.7.1.min.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/bootstrap.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/knockout-2.1.0.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/jquery.ba-bbq.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/scroll-startstop.events.jquery.js"></script>
    <script src="http://code.jquery.com/ui/1.10.0/jquery-ui.js"></script>

      <script type="text/javascript" src="{{ STATIC_URL }}scripts/oda.js"></script>
    
	{% block scripts %}{% endblock %}
	
