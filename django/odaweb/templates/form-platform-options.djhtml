<form id="form-platform-options">
    <div id="platform-options">

        <div>
            <div class="control-group">
                <label class="control-label upload-form-control" for="select-live-architecture">Arch</label>
                <select class="platformSelect input-small" id="select-live-architecture" name="select-live-architecture">
                    {% for a in supported_archs %}
                        <option
                            {% if a == arch %}selected="selected"{% endif %}>
                        {{a}}</option>
                  {% endfor %}
                </select>
            </div>
        </div>

        <div>
            <div class="control-group {% if form.errors.base_address %}error{% endif %}">
                <label class="control-label upload-form-control"
                       for="set-live-base-address">Base Address</label>
                <input id="set-live-base-address" name="base_address" type="text" placeholder="0x00000000" class="input-small" value="{{ base_address }}">
                {% if form.errors.base_address %}
                    <span class="help-inline">
                        {{ form.errors.base_address }}
                    </span>
                {% endif %}
            </div>
        </div>

        <div id="arch-specific-options">
            {% include 'show_options.djhtml' %}
        </div>
    </div>

</form>