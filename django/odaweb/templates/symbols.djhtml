<table id="symbol-table">
    <tr>
        <th align="right">Address</th>
        <th align="center">Type</th>
        <th align="left">Name</th>
    </tr>
    {% for s in symbols %}
        <tr>
            <td align="right">0x{{s.value|stringformat:'08x'}}</td>
            <td align="center">{{s.type|stringformat:'c'}}</td>
            <td align="left"><a href="#/view/assembly-tab-item/offset/{{s.value|stringformat:"08x"}}">{{s.name}}</a></td>
        </tr>
    {% endfor %}
</table>
