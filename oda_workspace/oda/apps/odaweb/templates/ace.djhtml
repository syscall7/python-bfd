               data-html="true"
               data-content="<p>You can share this url:</p><a href='{{ share_url }}'>{{ share_url }}</a><p><p>If you make more changes, hit <strong>share</strong> again to get a new link.</p>"
               id="menu-item-share">
                    <i class="glyphicon glyphicon-share glyphicon-white"></i>Share
            </a>
        </li>

       <!-- File Menu -->
       <li class="dropdown">
            <a class="dropdown-toggle" data-toggle="dropdown" href="#" id="menu-item-file">File<b class="caret"></b></a>
            <ul class="dropdown-menu">
                <li><a id="open-btn" href="_upload" data-toggle="modal"><i class="glyphicon glyphicon-upload"></i>&nbsp;Upload File...</a></li>
                <li><a id="download-btn" href="/odaweb/_download" data-toggle="modal"><i class="glyphicon glyphicon-download"></i>&nbsp;Download Disassembly</a></li>
                <li><a href="/odaweb"><i class="glyphicon glyphicon-play-circle"></i> Live Mode</a></li>
                <!--<li class="dropdown-submenu"><a href="#" tab-index="-1"><i class="icon-file"></i>&nbsp;New</a>
                    <ul class="dropdown-menu">

                    </ul>
                </li>
                <li class="dropdown-submenu"><a href="#" tab-index="-1"><i class="icon-folder-open"></i>&nbsp;Open Existing</a>
                    <ul id="open-existing-list" class="dropdown-menu">
                        <li class="disabled"><a href="#">No files exist</a></li>
                    </ul>
                </li>
                <li class="divider"></li>
                <li><a href="/odaweb/_save"><i class="icon-share"></i>Share</a></li>
                <li><a href="#">Download</a></li>-->
            </ul>
        </li>

       <!-- Edit Menu -->
       <li class="dropdown">
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">Edit<b class="caret"></b></a>
            <ul class="dropdown-menu">
                <!--
                <li><a href="#">Undo</a></li>
                <li><a href="#">Redo</a></li>
                <li class="divider"></li>
                <li><a class="nav-btn"
                       rel="tooltip"
                       data-original-title="Platform Settings"
                       data-panel="platform-display" href="#"><i class="icon-pencil"></i>&nbsp;Platform Options</a></li>
                <li class="divider"></li>
                 -->
                <li><a id="menu-go-to-addr" ng-click="GoToAddressPrompt()" href="#">Go to address... (Ctrl-g)</a></li>
                <li><a class="nav-btn" data-panel="find-results-display">Find sequence of bytes... (Ctrl-f)</a></li>

            </ul>
        </li>

       <!-- Help Menu -->
       <li class="dropdown">
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">Help<b class="caret"></b></a>
            <ul class="dropdown-menu">
                <li><a id='whats-oda-btn' href="#" data-toggle="modal">What's ODA?</a></li>
                <li><a id='tutorial-btn' href="http://blog.onlinedisassembler.com/blog/?p=44">Tutorial</a></li>
                <li class="divider"></li>
                <li><a id='about-oda-btn' href="#" data-toggle="modal">About</a></li>
            </ul>
        </li>

        <!-- Blog Menu -->
        <li class="">
            <a href="http://blog.onlinedisassembler.com/blog/">Blog</a>
        </li>
        <!-- Contact Us Menu -->
        <li class="">
            <a href=mailto:admin@onlinedisassembler.com>Contact Us!</a>
        </li>
    </ul>



      <form class="navbar-form navbar-right" role="form">
        <div class="form-group">
          <input type="text" placeholder="Email" class="form-control">
        </div>
        <div class="form-group">
          <input type="password" placeholder="Password" class="form-control">
        </div>
        <button type="submit" class="btn btn-success">Sign in</button>
      </form>
    </div><!--/.navbar-collapse -->
  </div>
</div>

<div>
    <div id="slider" style="margin-top:50px; margin-bottom: 0px; margin-right: 15px; border: 0px; clear:both;">
        <canvas id="addr-bar-canvas">You need to upgrade your browser to see this!</canvas>
    </div>
    <div style="color:gray; font-family:monospace; margin-right: 15px; float:right">0x0</div>
</div>

<div class="loading-spinner"></div>

<div class="theeditor" style="display:none;">

<div class="ui-layout-center">
    <div class="ui-layout-west" style="padding:10px;"
            ng-controller="DockController">

        <!--<div class="sidebar-hex"
             style="display: none">{% include 'sidebar-hex.djhtml' %}</div> -->
        <div ng-repeat="dock in Docker.docks"
             ng-show="isActive(dock)"
             ng-include="dock.template">

        </div>


    </div>

    <div class="ui-layout-center">
        <div id="editor"></div>
    </div>

</div>

<div class="ui-layout-east">Outer East</div>

<div class="ui-layout-west plunker-paneselector blue" ng-controller="DockMenuController">
    <ul>
        <li ng-repeat="dock in Docker.docks"
            ng-class="{active:isActive(dock)}"
            ng-click="Docker.select(dock)">
            <a><i class="fa fa-3" ng-class="dock.icon"></i></a>
        </li>
    </ul>
</div>


</div>
<div id="statusbar-container">
<div id="statusBar"><span class="status-mode">online disassembler forever!</span><div class="ace_status-indicator" style="display: inline-block;">61:0</div></div>
</div>

<div id="my-modal" class="modal fade">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4 class="modal-title">Comment Dialog</h4>
      </div>
      <div class="modal-body">
          <p class="commentLine"></p>
          <input class="comment-text" type="text" style="width:500px;"/>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Save changes</button>
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

