{% load staticfiles %}
{% load tags %}

<!DOCTYPE html>
<html lang="en">
<head>

    <title>{%  block title %}ODA - The Online Disassembler{% endblock %}</title>
    <link rel="icon" type="image/png" href="{% static 'images/oda.png' %}" />

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/nprogress/nprogress.css' %}" />
    <link rel="stylesheet" type="text/css" href="{% static 'css/oda3.css' %}" />
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/font-awesome-4.0.3/css/font-awesome.css' %}" />


    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.2/css/bootstrap.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.2/css/bootstrap-theme.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/context/context.standalone.css' %}" />
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/font-awesome-4.0.3/css/font-awesome.css' %}" />

    <script type="text/javascript" src="{% static 'scripts/lib/keypress-2.0.3.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery/jquery-1.11.1.min.js' %}" ></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery.cookie.js' %}" ></script>
    <script type="text/javascript" src="{% static 'scripts/lib/context/context.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/bootstrap-3.2/js/bootstrap.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery-ui-1.10.4.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular-route.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular-sanitize.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/ui-utils-0.1.1/ui-utils.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/ui-bootstrap-tpls-0.11.0.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/socket.io-1.0.6.js' %}"></script>

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/ui-layout/layout-default-latest.css' %}" />
    <script type="text/javascript" src="{% static 'scripts/lib/ui-layout/jquery.layout-rc30.79.js' %}"></script>


<style type="text/css" media="screen">


</style>
</head>
<body>

<div ng-include="'/static2/templates/navbar.html'"></div>

<div>
    <div id="slider" style="margin-top:50px; margin-bottom: 0px; margin-right: 15px; border: 0px; clear:both;">
        <canvas id="addr-bar-canvas">You need to upgrade your browser to see this!</canvas>
    </div>
    <div style="color:gray; font-family:monospace; margin-right: 15px; float:right">0x0</div>
</div>

<div class="loading-spinner"></div>

<div class="theeditor" style="display:none;">

<div class="ui-layout-center">
    <div class="ui-layout-west" style="padding:10px;"
            ng-controller="DockController">

        <!--<div class="sidebar-hex"
             style="display: none">{% include 'sidebar-hex.djhtml' %}</div> -->
        <div ng-repeat="dock in Docker.docks"
             ng-show="isActive(dock)"
             ng-include="dock.template">

        </div>


    </div>

    <div class="ui-layout-center">
        <div id="editor"></div>
    </div>

</div>

<div class="ui-layout-east">Outer East</div>

<div class="ui-layout-west plunker-paneselector blue" ng-controller="DockMenuController">
    <ul>
        <li ng-repeat="dock in Docker.docks"
            ng-class="{active:isActive(dock)}"
            ng-click="Docker.select(dock)">
            <a><i class="fa fa-3" ng-class="dock.icon"></i></a>
        </li>
    </ul>
</div>


</div>
<div id="statusbar-container">
<div id="statusBar"><span class="status-mode">online disassembler forever!</span><div class="ace_status-indicator" style="display: inline-block;">61:0</div></div>
</div>

{% verbatim %}
<script type="text/ng-template" id="commentModal.html">

    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4 class="modal-title">Comment Dialog</h4>
    </div>
    <div class="modal-body">

          <p class="commentLine" ng-bind-html="line.line.row"></p>
          <input class="comment-text" type="text"
                 style="width:500px;"
                 ng-model="comment.text"
                 ui-keyup="{'enter':'save()'}"
          />

    </div>
    <div class="modal-footer">
        <button class="btn btn-primary" ng-click="save()">Save</button>
        <button class="btn btn-warning" ng-click="cancel()">Close</button>
    </div>

</script>

<script type="text/ng-template" id="configureFileModal.html">
    <div class="modal-header">
        <button type="button" class="close" ng-click="cancel()">&times;</button>
        <h3>Configure Upload...</h3>
    </div>
    <div class="modal-body">

        <div class="alert alert-success">
            We have detected the object file format as {{ fileData.target }}:
            <ul>
                <li ng-repeat="f in data.fileData.file_format">{{ f }}</li>
            </ul>
            <br>
            Please select from the platform options below:
        </div>

        <div class="alert alert-info">
            <div class="checkbox">
                <label>
                  <input type="checkbox" ng-model="data.sandbox">Run Live in a Sandbox and Memory Dump
                </label>
            </div>
        </div>

        <div class="live-mode-platform-options-form" ng-include src="optionsTemplate()">
        </div>

    </div>
    <div class="modal-footer">
        <button class="btn btn-primary" ng-click="ok()">OK</button>
        <button class="btn btn-warning" ng-click="cancel()">Cancel</button>
    </div>
</script>

<script type="text/ng-template" id="monitorSandbox.html">
    <div class="modal-header">
        <button type="button" class="close" ng-click="cancel()">&times;</button>
        <h3>Sandbox and Memory Dump</h3>
    </div>
    <div class="modal-body">

        <p><strong>Status:</strong> {{ job_status.status || "provisioning"}}</p>
        <p><strong>Elapsed Time:</strong> {{ job_status.elapsed_time }}</p>
        <pre>{{ job_status.msg }}</pre>

    </div>
    <div class="modal-footer">
        <button class="btn btn-primary" ng-disabled="job_status.status != 'reported'" ng-click="continue()">continue</button>
    </div>
</script>
{% endverbatim %}

<script type="text/javascript" src="{% static 'scripts/lib/src-noconflict/ace.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/handlebars-v1.3.0.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/nprogress/nprogress.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/underscore-1.3.3.js' %}"></script>
<script type="text/javascript" src="{% static 'scripts/addrbar.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/oda_ace.js' %}" ></script>


<script type="text/javascript" src="{% static 'scripts/controllers/SymbolsController.js' %}"></script>
<script type="text/javascript" src="{% static 'scripts/controllers/LiveEntryController.js' %}"></script>
<script type="text/javascript" src="{% static 'scripts/controllers/OptionsViewController.js' %}"></script>
<script type="text/javascript" src="{% static 'scripts/controllers/StringsController.js' %}"></script>
<script type="text/javascript" src="{% static 'scripts/controllers/FindBytesController.js' %}"></script>
<script type="text/javascript" src="{% static 'scripts/controllers/SectionsController.js' %}"></script>

<script type="text/javascript">

    {% autoescape off %}

    window.examples = JSON.parse('{{ examples | jsonify }}');

    window.user = {
        username : '{% if not user.is_authenticated %}anonymous{% else %}{{ user.username }}{% endif %}',
        authenticated: {{ user.is_authenticated | jsonify }}
    };

    window.oda_master = {
        project_name : {{ master.project_name| jsonify }},
        short_name : '{{master.short_name }}',
        content_type : '{{ master.content_type.id }}',
        object_id : {{ master.object_id }},
        revision : {{ master.revision | jsonify}},
        section_info : {
            start_addr : {{ section_info.start_addr }},
            stop_addr : {{ section_info.stop_addr }}
        },
        binary : {
            id : '0',
            liveMode : {{ binary.is_live_mode|jsonify  }},
            arch : '{{ binary.options.architecture }}',
            size : '{{ binary.size|filesizeformat }}',
            text : {% if binary.is_live_mode %}{{ binary.binary_string_display | jsonify }}{% else %}""{%  endif %},
            options: {
                architecture: {{  binary.options.architecture | jsonify }},
                base_address: {{  binary.options.base_address | jsonify }},
                endian: {{ binary.options.endian | jsonify }},
                selected_opts: {{  binary.options.selected_opts | jsonify }}
            }
        }
    };

    {% endautoescape %}


    $(document).ready(function() {


    });
</script>

</body>
</html>