{% load staticfiles %}
{% load tags %}

<!DOCTYPE html>
<html lang="en" ng-app="odaApp">
<head>
<title>ACE in Action</title>

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/nprogress/nprogress.css' %}" />
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/font-awesome-4.0.3/css/font-awesome.css' %}" />

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.0.3/css/bootstrap.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.0.3/css/bootstrap-theme.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/font-awesome-4.0.3/css/font-awesome.css' %}" />

    <script type="text/javascript" src="{% static 'scripts/lib/jquery/jquery-1.8.3.min.js' %}" ></script>
    <script type="text/javascript" src="{% static 'scripts/lib/bootstrap-3.0.3/js/bootstrap.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery-ui-1.10.4.js' %}"></script>

    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular-route.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular-sanitize.min.js' %}"></script>

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/ui-layout/layout-default-latest.css' %}" />
    <script type="text/javascript" src="{% static 'scripts/lib/ui-layout/jquery.layout-rc30.79.js' %}"></script>


<style type="text/css" media="screen">
    body {
        margin: 0px;
    }
    #editor {
        width:100%;
    }
    .theeditor {
        position: absolute;
        top: 25px;
        right: 0;
        bottom: 20px;
        left: 0;
    }

    .ace_gutter-cell {
        text-align:left;
    }

    .branchLines {
        color: #093C83;
        text-align: right;
        width:49px;
        display:inline-block;
        overflow: hidden;
    }

    .raw {
        color: gray;
    }

    .instruction {
        color: #093C83;
    }

    .function-return {
        font-style: italic;
    }

    .function-name {
        font-weight: bold;
    }

     #statusBar {
        margin: 0;
        padding: 0;
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 20px;
        background-color: rgb(245, 245, 245);
        color: gray;
    }
    .ace_status-indicator {
        color: gray;
        position: absolute;
        right: 0;
        border-left: 1px solid;
    }





    .plunker-paneselector .pulse-info a i {
  -webkit-animation-name: pulse-info;
  -webkit-animation-duration: 2s;
  -webkit-animation-iteration-count: infinite;
  -webkit-animation-timing-function: ease-in-out;
  -webkit-animation-direction: alternate;
  -moz-animation-name: pulse-info;
  -moz-animation-duration: 2s;
  -moz-animation-iteration-count: infinite;
  -moz-animation-timing-function: ease-in-out;
  -moz-animation-direction: alternate;
}
.plunker-paneselector {
  background: whiteSmoke;
  text-align: center;
  overflow: visible;
}
.plunker-paneselector ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
.plunker-paneselector ul li {
  text-align: center;
  font-size: 16px;
  position: relative;
  margin: 0;
  padding: 0;
}
.plunker-paneselector ul li a {
  display: inline-block;
  width: 40px;
  height: 40px;
  line-height: 40px;
  vertical-align: center;
  color: #999;
  text-decoration: none;
  font-size: 20px;
  padding: 0;
}
.plunker-paneselector ul li:hover a {
  color: #005580;
  background-color: #EEE;
}
.plunker-paneselector ul li.active a {
  text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.2);
  background-color: #08C;
  color: white;
}


</style>
</head>
<body>

<div>
    <div id="slider" style="margin-bottom: 0px; margin-right: 15px; border: 0px;">
        <canvas id="addr-bar-canvas">You need to upgrade your browser to see this!</canvas>
    </div>
    <div style="color:gray; font-family:monospace; margin-right: 15px; float:right">0x0</div>
</div>

<div class="theeditor">

<div class="ui-layout-center">
    <div class="ui-layout-west" style="padding:10px;">

        <div style="display: none">{% include 'sidebar-hex.djhtml' %}</div>

        <div ng-include="'/static2/templates/symbols.html'"
             id="strings-content">
        </div>

    </div>

    <div class="ui-layout-center">
        <div id="editor"></div>
    </div>

</div>

<div class="ui-layout-east">Outer East</div>

<div class="ui-layout-west plunker-paneselector blue">
    <ul>
    <!-- ngRepeat: pane in panes.panes | orderBy:'order' -->
    <li tooltip="Live Preview" tooltip-placement="left">
      <a>
        <i class="fa fa-eye-slash fa-3"></i>
      </a>
    </li><li tooltip="Find and external libraries" tooltip-placement="left">
      <a>
        <i class="fa fa-book"></i>
      </a>
    </li><li tooltip="Templates" tooltip-placement="left">
      <a>
        <i class="fa fa-briefcase"></i>
      </a>
    </li>
        <li tooltip="Info" tooltip-placement="left" class="active">
      <a>
        <i class="fa fa-dashboard"></i>
      </a>
    </li><li tooltip="Code Linting" tooltip-placement="left" >
      <a >
        <i class="fa fa-check"></i>
      </a>
    </li><li tooltip="Collaboration" tooltip-placement="left" >
      <a>
        <i class="fa fa-retweet"></i>
      </a>
    </li><li tooltip="Editor Options" tooltip-placement="left">
      <a>
        <i class="fa fa-cog"></i>
      </a>
    </li>
    </ul>
</div>


</div>
<div id="statusbar-container">
<div id="statusBar"><span class="status-mode">online disassembler forever!</span><div class="ace_status-indicator" style="display: inline-block;">61:0</div></div>
</div>


<div id="my-modal" class="modal fade">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4 class="modal-title">Comment Dialog</h4>
      </div>
      <div class="modal-body">
          <p class="commentLine"></p>
          <input class="comment-text" type="text" style="width:500px;"/>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Save changes</button>
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<script type="text/javascript" src="{% static 'scripts/lib/src-noconflict/ace.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/handlebars-v1.3.0.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/nprogress/nprogress.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/underscore-1.3.3.js' %}"></script>
<script type="text/javascript" src="{% static 'scripts/addrbar.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/oda_ace.js' %}" ></script>


<script type="text/javascript" src="{% static 'scripts/controllers/SymbolsController.js' %}"></script>


<script type="text/javascript">

    $(document).ready(function() {
        $('.theeditor').layout({
			west__size: 41,
            west__closable: false,
            west__resizable: false,
            west__spacing_open:0,
            west__spacing_closed:0,
            center__childOptions: {
                spacing_open: 2,
                spacing_closed: 2,
                closable: false,
                west__size: 400
            },

            east__minSize: 150,

            spacing_open: 2,
            spacing_closed: 2
		});

    });
</script>

</body>
</html>