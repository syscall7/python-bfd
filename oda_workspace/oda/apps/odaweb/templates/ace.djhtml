{% load staticfiles %}
{% load tags %}

<!DOCTYPE html>
<html lang="en" ng-app="odaApp">
<head>
<title>ACE in Action</title>

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/nprogress/nprogress.css' %}" />
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/font-awesome-4.0.3/css/font-awesome.css' %}" />

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.2/css/bootstrap.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.2/css/bootstrap-theme.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/font-awesome-4.0.3/css/font-awesome.css' %}" />

    <script type="text/javascript" src="{% static 'scripts/lib/jquery/jquery-1.8.3.min.js' %}" ></script>
    <script type="text/javascript" src="{% static 'scripts/lib/bootstrap-3.2/js/bootstrap.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery-ui-1.10.4.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/keypress-2.0.1.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular-route.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/angular-1.2.10/angular-sanitize.min.js' %}"></script>

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/ui-layout/layout-default-latest.css' %}" />
    <script type="text/javascript" src="{% static 'scripts/lib/ui-layout/jquery.layout-rc30.79.js' %}"></script>


<style type="text/css" media="screen">
    body {
        margin: 0px;
    }
    #editor {
        width:100%;
    }
    .theeditor {
        position: absolute;
        top: 90px;
        right: 0;
        bottom: 20px;
        left: 0;
    }

    .ace_gutter-cell {
        text-align:left;
    }

    .branchLines {
        color: #093C83;
        text-align: right;
        width:49px;
        display:inline-block;
        overflow: hidden;
    }

    .raw {
        color: gray;
    }

    .instruction {
        color: #093C83;
    }

    .function-return {
        font-style: italic;
    }

    .function-name {
        font-weight: bold;
    }

     #statusBar {
        margin: 0;
        padding: 0;
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 20px;
        background-color: rgb(245, 245, 245);
        color: gray;
    }
    .ace_status-indicator {
        color: gray;
        position: absolute;
        right: 0;
        border-left: 1px solid;
    }

    .navbar-brand {
        background: url('/static2/images/oda.png') no-repeat center;
        background-size: 50px;
        width: 70px;
    }


.blue-white-table td, .blue-white-table th
{
    padding:3px 10px 3px 10px;
}

.blue-white-table th
{
    background-color:#92C1F0;
    color:#000000;
}

.blue-white-table tr.even td
{
    color:#000000;
}

.blue-white-table tr.odd td
{
    color:#000000;
    background-color:#C8DEFF;
}


    .plunker-paneselector .pulse-info a i {
  -webkit-animation-name: pulse-info;
  -webkit-animation-duration: 2s;
  -webkit-animation-iteration-count: infinite;
  -webkit-animation-timing-function: ease-in-out;
  -webkit-animation-direction: alternate;
  -moz-animation-name: pulse-info;
  -moz-animation-duration: 2s;
  -moz-animation-iteration-count: infinite;
  -moz-animation-timing-function: ease-in-out;
  -moz-animation-direction: alternate;
}
.plunker-paneselector {
  background: whiteSmoke;
  text-align: center;
  overflow: visible;
}
.plunker-paneselector ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
.plunker-paneselector ul li {
  text-align: center;
  font-size: 16px;
  position: relative;
  margin: 0;
  padding: 0;
}
.plunker-paneselector ul li a {
  display: inline-block;
  width: 40px;
  height: 40px;
  line-height: 40px;
  vertical-align: center;
  color: #999;
  text-decoration: none;
  font-size: 20px;
  padding: 0;
}
.plunker-paneselector ul li:hover a {
  color: #005580;
  background-color: #EEE;
}
.plunker-paneselector ul li.active a {
  text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.2);
  background-color: #08C;
  color: white;
}
.plunker-paneselector ul li {
    cursor: pointer;
}

/*Nprogress Bar*/
#nprogress .bar,
#nprogress .spinner {
    z-index: 999999;
    }


.loading-spinner {
    position: relative;
    font-size: 100px;
    width: 1em;
    height: 1em;
    margin: 100px auto;
    border-radius: 50%;
    background: #123456;
    box-shadow: inset 0 0 0 .12em rgba(0,0,0,0.2), 0 0 0 .12em rgba(255,255,255,0.1);
    background:
        -webkit-linear-gradient(#FA4B00 50%, #1F1F1F 50%),
        -webkit-linear-gradient(#1F1F1F 50%, #FA4B00 50%);
    background:
        -webkit-linear-gradient(#FA4B00 50%, #1F1F1F 50%), -webkit-linear-gradient(#1F1F1F 50%, #FA4B00 50%);
    background:
        linear-gradient(#FA4B00 50%, #1F1F1F 50%),
        linear-gradient(#1F1F1F 50%, #FA4B00 50%);
    background-size: 50% 100%, 50% 100%;
    background-position: 0 0, 100% 0;
    background-repeat: no-repeat;
    opacity: 0.7;
    -webkit-animation: mask 3s infinite alternate;
    animation: mask 3s infinite alternate;
}

.loading-spinner:after {
    content: "";
    position: absolute;
    border: .12em solid rgba(255,255,255,0.3);
    position: absolute;
    top: 25%;
    left: 25%;
    width: 50%;
    height: 50%;
    border-radius: inherit;
}

@-webkit-keyframes mask {
    0% { }
    25%  { -webkit-transform: rotate(270deg); }
    50%  { -webkit-transform: rotate( 90deg); }
    75%  { -webkit-transform: rotate(360deg); }
    100% { -webkit-transform: rotate(180deg); }
}

@keyframes mask {
    0% { }
    25%  { -webkit-transform: rotate(270deg); transform: rotate(270deg); }
    50%  { -webkit-transform: rotate( 90deg); transform: rotate( 90deg); }
    75%  { -webkit-transform: rotate(360deg); transform: rotate(360deg); }
    100% { -webkit-transform: rotate(180deg); transform: rotate(180deg); }
}

</style>
</head>
<body>

<div class="navbar navbar-fixed-top" role="navigation">
  <div class="container-fluid">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a class="navbar-brand" style="padding-left: 70px;" href="#">ODA</a>
    </div>
    <div class="navbar-collapse collapse">

    <ul class="nav navbar-nav" style="padding-left:100px;">
        <li class="share-btn">
            <a href="/odaweb/_save"
