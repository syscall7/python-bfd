<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
    <h3>Open File</h3>
</div>
<div class="modal-body">
    <form id="upload-form" class="form-horizontal"
          enctype="multipart/form-data"
          action="_upload" method="post">
            <div class="control-group {% if form.errors.project_name %}error{% endif %}">
                <label class="control-label" for="project_name">Project Name:</label>
                <div class="controls">
                    <input name="project_name" id="project_name" class="input-medium" placeholder="My Project" type="text" value="">
                    {% if form.errors.project_name %}
                        <span class="help-inline">
                            {{ form.errors.project_name }}
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="control-group {% if form.errors.filedata %}error{% endif %}">
                <label class="control-label" for="filename">File:</label>
                <div class="controls">
                    <div class="input-append">
                        <input id="filename" type="text" class="input-medium disabled" name="filename" readonly>
                        <input type="file" id="file" name="filedata" style="display: none;">
                        <a id="fileselectbutton" class="btn add-on">Choose File...</a>
                    </div>
                    {% if form.errors.filedata %}
                        <span class="help-inline">
                            {{ form.errors.filedata }}
                        </span>
                    {% endif %}
                </div>
            </div>
    </form>
</div>
<div class="modal-footer">
    <a href="#" class="btn" data-dismiss="modal">Cancel</a>
    <a id="upload-submit-btn" href="#" class="btn btn-primary">Upload</a>
</div>
