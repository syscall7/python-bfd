<div id="sidebar">
    <div id="sidebar-container" style="padding-left: 10px; padding-top: 5px;">
        <div id="sidebar-tools" class="btn-toolbar pull-right">
            <div class="btn-group">
                <a class="btn nav-btn"
                   data-panel="symbols-display"
                   data-toggle="tooltip"
                   title="Symbols"
                   id="symbols-btn"
                   href="#">
                    <i class="icon-list"></i>
                </a>
                <a class="btn nav-btn"
                   data-panel="hex-display"
                   data-toggle="tooltip"
                   title="Raw Bytes"
                   id="hex-display-btn"
                   href="#"><i class="icon-asterisk"></i>
                </a>
                <a class="btn nav-btn" data-panel="strings-display"
                   data-toggle="tooltip"
                   title="Strings"
                   href="#">
                    <i class="icon-font"></i>
                </a>
            </div>
        </div>

        <div id="sidebarContent">
            {% include 'sidebar-hex.djhtml' %}
        
            <div id="strings-display"
                 style="padding:5px; background-color:white;"
                 class="item">
                <div class="sidebar-legend">Strings</div>
                <div class="sidebar-content">
                    <div class="sidebar-scroll-container"
                         ng-include="'/static2/templates/strings.html'"
                         id="strings-content">
                    </div>
                </div>
            </div>

        
            <div id="symbols-display" style="padding:5px; background-color: white;" class="item">
                <div class="sidebar-legend">Symbols</div>
                <div class="sidebar-content">
                    <div class="sidebar-scroll-container"
                         ng-include="'/static2/templates/symbols.html'"
                         id="strings-content">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>