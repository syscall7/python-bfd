{% extends "layout.djhtml" %}

{% block content %}

<script type="text/javascript">
     function doFormSubmit() {
    	$('#oda-gear').show();
    	var swfuploadify = window['uploadify_' + 'file_upload'];
    	swfuploadify.addPostParam('platformId', $('#platformSelect').val());
	 	$('#file_upload').uploadifyUpload();
 	}
	 function doFormCancel() {
		 $('#modal-from-dom').modal('hide');
	 }
 
 $(document).ready(function() { 
 	 var activeDocument = null; 
 	 
	 var processDisassembly = function(ret) { 
		activeDocument = ret; 
		$('#listing').html(ret.opcodeHtml);
		$('#rawBytes').html(ret.rawBytesHtml);
		$('#offset').html(ret.offsetHtml);
		$('#branchLines').html(ret.branchTargetHtml);
		
		$('#strings-content').html(ret.stringHtml);
		$('#sections-content').html(ret.sectionHtml);
        $('#hex-content').val(ret.hexDump);
        $('#file-name-content').html(ret.fileName);
        $('#file-type-content').html(ret.fileTypeStr);
		$('#modal-from-dom').modal('hide');
		var lines = '<p style="font-size:125%;background-color:black;color:white;padding:5px;">' + ' Showing ' + ret.currentLines + ' of ' + ret.totalLines + ' lines'; 
		if (ret.totalLines > ret.currentLines) { 
			lines += ' <a href="#" id="more-btn" style="font-weight:bold;"> more </a>';
		}
		lines += '</p>';
		$('#more-assembly').html(lines)
		$('#oda-gear').hide();  
	 };
	 
	 $('#more-assembly').delegate('#more-btn','click',function() {
		 $('#oda-gear').show();  
		 $.ajax('/rest/disassemble/disassembleMore',{
			 type: 'GET',
			 data: {
				 	id : activeDocument.id, 				 	
				 	offset : 0,
				 	length : activeDocument.currentLines + 1000
			  }, 
			 success: function(data) { 
				// var ret = jQuery.parseJSON( data ); 	
				 processDisassembly(data); 
				 $('#assembly-tab-item').trigger('click');
			 }
		 });
	 }); 
	 
	 $('#login-form').popover({
		 placement: 'bottom',
		 delay: '5000',
		 trigger: 'hover',
         content: function() { 
             return '<p>Do you already have an account on one of these sites? Click the logo to log in with it here:</p>'
             +'<a href="openid?provider=google"><img src="{{ STATIC_URL }}images/openid_google.png"/></a> '
             + '<a href="openid?provider=yahoo"><img src="{{ STATIC_URL }}images/openid_yahoo.png"/></a>'; } 
	 }); 
	 $('#login-form').popover('show');
	 setTimeout(function() {$('#login-form').popover('hide');},6000 ); 
	 $('.tabs').tab('show');
	 $('#assembly-tab-item').trigger('click');
	 
	 $('#save-hex,#disassembleBtn').click(function() { 
		 $('#oda-gear').show(); 
		 $.ajax('/disassemble/uploadHex',{
			 type: 'POST',
			 data: {
				 	hex_val : $('#hex-content').val(), 
				 	platformId : $('#platformSelect').val(), 
				 	endian : $('#endianSelect').val(),
				 	offset : $('#offsetInput').val()
			  }, 
			 success: function(data) { 
				// var ret = jQuery.parseJSON( data ); 	
				 processDisassembly(data); 
				 $('#assembly-tab-item').trigger('click');
			 }, 
			 error : function(jqXHR, textStatus, errorThrown) {
			 	alert('here');  
			 }
		 }); 
		 return false; 
	 }); 
	 
  $('#file_upload').uploadify({
     	// Required Settings
		//langFile : '/jquery.uploadify-v3.0.0/uploadifyLang_en.js',
		swf : '{{ STATIC_URL }}scripts/lib/uploadify/uploadify.swf',
		checkExisting : '/disassemble/checkExisting',
		uploader : '/disassemble/uploadFile', 
		//debug : true, 
		buttonText : 'SELECT FILE',
		auto : false,
		buttonImage : '',
		cancelImage : '{{ STATIC_URL }}images/uploadify-cancel.png',
		multi : false,
		fileTypeExts : '*',
		progressData    : 'all',		
		'removeCompleted' : true,
		onUploadSuccess : function(file,data,response) {
			var ret = jQuery.parseJSON( data ); 	
			processDisassembly(ret); 
		}		  
     });    
 }); 
 
 /*
 $(document).ready(function() {
     $('#file-upload-btn').click(function() { 
         $('#modal-from-dom').modal('show');
     }); 
 });
 */

 </script>

<div class="content">
    <div class="page-header row">
            <img src="{{ STATIC_URL }}images/oda.png" class="span2" style="width: 106px; height: 94px; margin-bottom: -10px;"/>
            <img src="{{ STATIC_URL }}images/oda.gif" style="width: 106px; height: 94px; float:left; position: relative; left: -106px; margin-right:-115px; " id="oda-gear"/>
            <h1 class="span6">Online Disassembler</h1>
            
    </div>
    <div class="row">
        <div class="span12">
            <b>File:</b> 
            <span id="file-name-content">file_name_goes_here</span>
            [<span id="file-type-content">file_type_goes_here</span>]
        </div>
    </div>
             
    <form class="well form-inline">      
		<button data-toggle="modal" data-target="#modal-from-dom" data-backdrop="true" data-keyboard="true" class="btn btn-danger">Upload File&nbsp;<i class="icon-file icon-white"></i></button> 
        <label class="control-label upload-form-control" for="platformSelect">Platform</label>
        <select class="span2" id="platformSelect" name="normalSelect">
            <option>X86</option>
            <option>MIPS</option>
            <option>ARM</option>
            <option>PPC</option>                        
        </select>
         <label class="control-label upload-form-control" for="endianSelect">Endian</label>
           <select class="span2" id="endianSelect" name="normalSelect">
               <option>LITTLE</option>
               <option>BIG</option>
               <option>DEFAULT</option>
           </select>
       <label class="control-label upload-form-control" for="offsetInput">Offset</label>
       <input id="offsetInput" class="span2" type="text" name="offset" value="0x0"/>
       <button class="btn btn-primary pull-right" type="submit" id="disassembleBtn"> Disassemble&nbsp;<i class="icon-refresh icon-white"></i></button>
    </form>
            
    <ul class="nav nav-tabs">
        <li class="active" ><a data-toggle="tab" href="#hex">Hex</a></li>
        <li><a data-toggle="tab" href="#assembly" id="assembly-tab-item">Assembly</a></li>
        <li><a data-toggle="tab" href="#strings">Strings</a></li>
        <li><a data-toggle="tab" href="#sections">Sections</a></li>
    </ul>
          
    <div id="myTabContent" class="tab-content">
        
        <!--  HEX TAB CONTENT -->
        <div class="tab-pane" id="hex">
            <form class="well">
                <input class="btn btn-primary" type="submit" value="Save" id="save-hex">
            </form>
            <textarea class="tabbed-scroll" style="width:100%;"  id="hex-content">Enter raw hex bytes here.</textarea>
              
        </div>
        
        <!--  ASSEMBLY TAB CONTENT -->
        <div class="active tab-pane" id="assembly">
			<div class="tabbed-scroll assembly">
                <div id="branchLines" style="width:200px; text-align:right; float:left; font-family:DejaVuSansMono; color:#093C83"></div>
				<div id="offset" style="width:120px; float:left; color:black; text-align: left; white-space: pre;"></div>
				<div id="rawBytes" style="width:100px; float:left; color:grey; text-align: left; white-space: pre;"></div>
				<div id="listing" style="width:600px; padding-left:300px; white-space: pre; font-weight: bold; 'Helvetica Neue', Helvetica, Arial, sans-serif"></div>
			</div> 
			<div id="more-assembly"></div>			          
        </div>
        
        <!--  STRINGS TAB CONTENT -->
        <div class="tab-pane" id="strings">
            <div class="tabbed-scroll" id="strings-content"></div>
        </div>
        
        <!--  SECTIONS TAB CONTENT -->
        <div class="tab-pane" id="sections">
            <div class="tabbed-scroll" id="sections-content"></div>
        </div>           
    </div>
</div>  
      
<div id="modal-from-dom" class="modal hide fade">
    <div class="modal-header">
        <a href="#" class="close" data-dismiss="modal">&times;</a>
        <h3>File Upload</h3>
    </div>
     
    <div class="modal-body">
        <div>
            <div id="file_upload"></div>  
      	</div>
        {% include 'terms.djhtml' %}        
    </div>
    
    <div class="modal-footer">
        <a href="#" class="btn btn-primary" onclick="doFormSubmit()">Submit</a>
        <a href="#" class="btn btn-secondary" onclick="doFormCancel()">Cancel</a>
    </div>
</div>
   

{% include 'help.djhtml' %}  
      
{% endblock %}
        

