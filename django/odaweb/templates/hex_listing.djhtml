{% autoescape off %}
{% for chunk in chunks %}
    <tbody>
    {% for name, addr, bytes, ascii in chunk.hex_lines %}
        <tr addr={{ addr|stringformat:"08x" }}>

            {# section #}
            <td class="hex-cell-sec">{{ name }}:</td>

            {# address #}
            <td class="hex-cell-addr" id="p{{ addr|stringformat:'x'}}" >{{ addr|stringformat:"08x" }}</td>
            <td class="hex-cell-gap"></td>

            {# hex bytes #}
            {% for byte in bytes %}

                <td class="hex-cell-byte" id="h{{ addr|add:forloop.counter0|stringformat:'x'}}">
                    {{ byte }}
                </td>

                {# add gap #}
                {% if forloop.counter|divisibleby:"8" %}
                    <td class="hex-cell-gap"></td>
                {% endif %}

            {% endfor %}

            {# ascii bytes #}
            {% for asc in ascii %}
                <td class="hex-cell-asc" id="a{{ addr|add:forloop.counter0|stringformat:'x'}}">
                    {{ asc }}
                </td>
            {% endfor %}

        </tr>
    {% endfor %}
    </tbody>
{% endfor %}
{% endautoescape %}
