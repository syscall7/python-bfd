{% extends "refactor/layout-new.djhtml" %}

{% block head %}

    <script type="text/javascript">
    $(document).ready(function(){
       Load('{{ disassembly_id }}');
    });
    </script>

{% endblock %}

{% block content %}


    
    {% include "refactor/sidebar.djhtml" %}
        
    <div id="view">
        <div id="view-container">
            <!--div id="slider-container"-->
                <div id="slider" class="ui-slider ui-slider-horizontal ui-widget ui-widget-content ui-corner-all" aria-disabled="false" style="border: 0px none;">
                    <table id="coloredChunks">
                    <tbody>
                    <tr>
                    <td bgcolor="5d8fff" style="width:5%"></td>
                    <td bgcolor="3e79ff" style="width:10%"></td>
                    <td bgcolor="004eff"></td>
                    <td bgcolor="black"></td>
                    </tr>
                    </tbody>
                    </table>
                    <a class="ui-slider-handle ui-state-default" href="#" style="left: 0%;"></a>
                </div>
                <p> </p>
                <p> </p>
                <div id="location" style="color:gray; font-family:monospace">0x00000000</div>
            <!--/div-->    
            <ul class="nav nav-tabs" id="myTab" style="margin-bottom: 0px;">
                <li class="active"><a data-toggle="tab" href="#disassembly">Disassembly</a></li>
                <li class=""><a data-toggle="tab" href="#hex-dump">Hex Dump <i class="icon-remove-sign"></i> </a></li>
                <!--<li class="dropdown">
                    <a data-toggle="dropdown" class="dropdown-toggle" href="#">Dropdown <b class="caret"></b></a>
                    <ul class="dropdown-menu">
                        <li><a data-toggle="tab" href="#dropdown1">@fat</a></li>
                        <li><a data-toggle="tab" href="#dropdown2">@mdo</a></li>
                    </ul>
                </li>-->
            </ul>
            <div class="tab-content" id="myTabContent">
                {% include "refactor/tab-disassembly.djhtml" %}
                {% include "refactor/tab-hexdump.djhtml" %}
            </div>
    
        </div>
    
        <div id="status-bar">
            <a href="#" id="platform-option">i386-x64 </a>  | 176.6kb | filename.bin
        </div>
    </div>
    <div id="vertSplitter" class="vsplitbar"></div>
{% endblock %}