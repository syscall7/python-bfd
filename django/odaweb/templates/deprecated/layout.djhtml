    <link rel="stylesheet" type="text/css" media="all" href="{{ STATIC_URL }}css/oda.css"  />
    <style type="text/css">
        html {
            height:100%;        
        }
    
		body {
			/*padding-top: 60px;*/
			min-height:100%;
			height:100%;
			margin:0;
        }
      
        .container {
            min-height: 100%;
            position: relative;
        }
        
        .content {
            min-height: 100%; 
            padding-bottom: 50px;       
        }
        
        .well {
            padding: 10px;
            margin-bottom: 10px;
        }
        
        .tab-content {
            min-height:100%;
            height:100%;        
        }
        
        .tabs {
            margin-bottom: 10px;
        }
              
        .tabbed-scroll {
			/*height:200px;*/ 
			min-height: 100%;
			overflow:scroll; 
		}
      
		.navbar-wrapper {
            height: 40px;   
		    position: relative;
        }

		.navbar-wrapper .navbar {
		    margin: 0 -20px;
		    position: absolute;
		    z-index:1;
		}
		
		#modal-from-dom {
            margin: -160px 0 0 -280px;		
		}

		#assembly label {
			width:60px; 
		}
		
		.uploadSelect
		{
		  width:100px;
		}
		
		/*
        #upload-file-button { 
            background-color: hsl(32, 85%, 35%) !important; filter: progid:DXImageTransform.Microsoft.gradient(startColorStr="hsl(32, 85%, 59%)", endColorStr="hsl(32, 85%, 35%)"); background-repeat: repeat-x; background-image: -khtml-gradient(linear, left top, left bottom, from(hsl(32, 85%, 59%)), to(hsl(32, 85%, 35%))); background-image: -moz-linear-gradient(top, hsl(32, 85%, 59%), hsl(32, 85%, 35%)); background-image: -ms-linear-gradient(top, hsl(32, 85%, 59%), hsl(32, 85%, 35%)); background-image: -webkit-gradient(linear, left top, left bottom, color-stop(0%, hsl(32, 85%, 59%)), color-stop(100%, hsl(32, 85%, 35%))); background-image: -webkit-linear-gradient(top, hsl(32, 85%, 59%), hsl(32, 85%, 35%)); background-image: -o-linear-gradient(top, hsl(32, 85%, 59%), hsl(32, 85%, 35%)); background-image: linear-gradient(hsl(32, 85%, 59%), hsl(32, 85%, 35%)); border-color: hsl(32, 85%, 35%) hsl(32, 85%, 35%) hsl(32, 85%, 29%); color: #fff !important; text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.39); -webkit-font-smoothing: antialiased;    
        }
        */		
		
		.page-header {
            padding-top: 30px;		   
            margin-bottom: 0px;   
            margin-right: -20px;
		}
		
		.upload-form-control {
		    margin-left: 10px;
		}
		
		h1 {
		  margin-bottom: 0px;  
		}
		
		footer {
            bottom: 0;
            position: absolute;
            margin-top: 0px;
            padding-top: 0px;
            
		}
		
		#hex-content {
		    font-family: "Courier New",
		                 Courier,
		                 monospace;
            padding-top: 4px;
            padding-left: 0px;
            padding-right: 0px;    
		} 
    </style>

    <!-- Le fav and touch icons -->
    <link rel="shortcut icon" href="images/favicon.ico">
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="72x72" href="images/apple-touch-icon-72x72.png">

    <link rel="apple-touch-icon" sizes="114x114" href="images/apple-touch-icon-114x114.png">
    
    <link rel="stylesheet" type="text/css" media="all" href="{{ STATIC_URL }}css/uploadify.css" />
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/uploadify/jquery.uploadify.js"></script>
     
    <script type="text/javascript">
    var tabViewMinimumHeightHeight = 80;
    var tabViewPaddingToBottom = 60;
    
    $(document).ready(function() { 
    	$('#example-strcpy').click(function() { 
    		alert('here'); 
    		$.ajax({
    			  url: '/examples?type=strcpy',    			  
    			  success: function(){
    				  alert('done'); 
    			  },
    			  error: function(){
    				  alert('error');
    			  }
    		});
    	}); 
    	var example = function(fileName, fileTypeStr, assembly, platform) { 
    		$('#hex-content').val(assembly);
    		$('#platformSelect').val(platform);     	
    		$('#save-hex').click();
    		$('#file-name-content').html(fileName);
    		$('#file-type-content').html(fileTypeStr);
    		
    	    // Re-size according to browser height 
            resizeHandler();
    	};
    	
    	$('#example-strcpy-x86').click(function() { 
    		example('strcpy-x86.bin', 'raw binary (x86)', '55 31 D2 89 E5 8B 45 08 56 8B 75 0C 53 8D 58 FF 0F B6 0C 16 88 4C 13 01 83 C2 01 84 C9 75 F1 5B 5E 5D C3','X86'); 
    		return false; 
    	}); 
    	$('#example-strcpy-arm').click(function() { 
    		example('strcpy-arm.bin', 'raw binary (arm)', '01 20 40 E2 02 20 61 E0 01 30 D1 E4 00 00 53 E3 02 30 C1 E7 FB FF FF 1A 1E FF 2F E1','ARM');
    		return false; 
    	}); 
    	
    	// The "tab widgets" to handle.
    	/*   var tabs = $('.tabs'),
    	     
    	    // This selector will be reused when selecting actual tab widget A elements.
    	    tab_a_selector = '.tabs a';
    	   
    	  // Enable tabs on all tab widgets. The `event` property must be overridden so
    	  // that the tabs aren't changed on click, and any custom event name can be
    	  // specified. Note that if you define a callback for the 'select' event, it
    	  // will be executed for the selected tab whenever the hash changes.
    	  tabs.tabs({ event: 'foo' });
    	   
    	  // Define our own click handler for the tabs, overriding the default.
    	  tabs.click(function(){
    	    var state = {},
    	       
    	      // Get the id of this tab widget.
    	      id = $(this).closest( '.tabs' ).attr( 'id' ),
    	       
    	      // Get the index of this tab.
    	      idx = $(this).parent().prevAll().length;
    	     
    	    // Set the state!
    	    state[ id ] = idx;
    	    $.bbq.pushState( state );
    	  }); 
    	   
     	  // Bind an event to window.onhashchange that, when the history state changes,
     	  // iterates over all tab widgets, changing the current tab as necessary.
     	  $(window).bind( 'hashchange', function(e) {
    	     
     	    // Iterate over all tab widgets.
     	    tabs.each(function(){
  	       
     	      // Get the index for this tab widget from the hash, based on the
     	      // appropriate id property. In jQuery 1.4, you should use e.getState()
     	      // instead of $.bbq.getState(). The second, 'true' argument coerces the
     	      // string value to a number.
     	      var idx = $.bbq.getState( this.id, true ) || 0;
    	       
     	      // Select the appropriate tab for this tab widget by triggering the custom
     	      // event specified in the .tabs() init above (you could keep track of what
     	      // tab each widget is on using .data, and only select a tab if it has
     	      // changed).
     	      $(this).find( tab_a_selector ).eq( idx ).triggerHandler( 'foo' );
     	    });
     	  })
    	   
    	// Since the event is only triggered when the hash changes, we need to trigger
    	// the event now, to handle the hash the page may have loaded with.
    	$(window).trigger( 'hashchange' );
    	*/
    	
    	// Attach click events to tab items    		
    	$('a[data-toggle="tab"]').on('shown',resizeHandler);
    	
    }); 
    
    function resizeHandler() {
    	  var myWidth = 0, myHeight = 0;
          var availableHeight = 0;  
    	  if( typeof( window.innerWidth ) == 'number' ) {
    	    //Non-IE 
    	    myWidth = window.innerWidth;
    	    myHeight = window.innerHeight;
    	  } else if( document.documentElement && ( document.documentElement.clientWidth || document.documentElement.clientHeight ) ) {
    	    //IE 6+ in 'standards compliant mode' 
    	    myWidth = document.documentElement.clientWidth;
    	    myHeight = document.documentElement.clientHeight;
    	  } else if( document.body && ( document.body.clientWidth || document.body.clientHeight ) ) {
    	    //IE 4 compatible 
    	    myWidth = document.body.clientWidth;
    	    myHeight = document.body.clientHeight;
    	  }
    	  
    	  // Adjust height of the visible tab-scroller dynamically 
    	  $(document).find('.tabbed-scroll:visible').each( function() {
    		  var offset = $(this).offset();     		  
              availableHeight = myHeight - offset.top - tabViewPaddingToBottom - $("div.footer").height();
              if ( availableHeight < tabViewMinimumHeightHeight ) {
                  $(this).height(tabViewMinimumHeightHeight)
              } else {
                  $(this).height(availableHeight)
              }     		 
    	  });
    };

    // Use a timer for dynamic sizing for performance reasons 
    var resizeTimer;
    $(window).resize(function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resizeHandler, 100);
    });

    </script>
    
  </head>

  <body>

    <div class="navbar navbar-fixed-top">
      <div class="navbar-inner">
        <div class="container-fluid">
           <a class="brand" href="#">ODA</a> 

          <ul class="nav">
            <li class="active"><a href="#">Home</a></li>
            <li><a href="#about" data-controls-modal="help-modal">About</a></li>
            <!-- <li><a href="#contact">Contact</a></li>  -->
			<li class="dropdown" data-dropdown="dropdown">
			  
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" >Examples <span class="caret"></span> </a>
                  <ul class="dropdown-menu">
                    <li><a href="#fat" id="example-strcpy-x86">strcpy (x86)</a></li>
                    <li><a href="#mdo" id="example-strcpy-arm">strcpy (arm)</a></li>
                  </ul>

            </li>            
          </ul>
          <
          {% if loggedIn %} 
          <p class="pull-right">Logged in as <a href="#">{{ username }}</a></p>
        {% else %} 
 		<form id="login-form" action="login" class="navbar-form pull-right">	

              <!--<input class="input-small" type="text" 
            	name="username" placeholder="Username">

           <input class="input-small" type="password" 
            	name="password" placeholder="Password">  -->
            <button class="btn" type="submit" style="margin-left:220px;">Log in with OpenID</button> |
          <!--   <a class="btn small success" href="/signup">Sign Up</a>  -->
          </form>
          {% endif %} 
        </div>        
      </div>
      
    </div>

    <div class="container">
    
		{% block content %}{% endblock %}

        <footer>
          <span class="label label-warning">Notice</span>This site is still under heavy development.  Thanks for your patience!
          <p>&copy; Online Disassembler 2012</p>
        </footer>
    </div>
    
      	  
   <script type="text/javascript">
    $(document).ready(function() { 
    	$('#example-strcpy-x86').click();
    }); 
    </script>
  </body>
</html>
