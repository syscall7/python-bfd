# function to collect file uploads for a given date
def genUploadReport_v1(day):
    uploads = {}
    dayPattern = day.strftime('%Y%m%d') + '*'
    cnt = 0
    totalSize = 0
    smallest = sys.maxint
    largest = 0

    # for each uploaded file for the given day
    for upload in glob.iglob(os.path.join(UPLOAD_DIR,dayPattern)):
        cnt += 1

        # create upload descriptor
        ud = UploadDesc(upload)

        if ud.size < smallest:
            smallest = ud.size

        if ud.size > largest:
            largest = ud.size

        totalSize += ud.size

        # if we've already seen this exact file
        if ud.md5 in uploads:
            uploads[ud.md5].hits.extend(ud.hits)
        # else, it's new
        else:
            uploads[ud.md5] = ud

    output = 'ODA Upload Report for %s\n\n' % day.strftime('%A, %B %d, %Y')

    output += 'Total Files: %d\n' % cnt
    output += 'Unique Files: %d\n' % len(uploads)
    output += 'Total Size: %d\n' % totalSize
    output += 'Smallest File: %d\n' % smallest
    output += 'Largest File: %d\n' % largest

    output += '\n\n'

    # sort based on timestamp of first hit
    for md5, ud in sorted(uploads.iteritems(), key=lambda (k,v): v.hits[0][0]):
        output += 'MD5: %s, Size: %d, Type: %s\n' % (ud.md5, ud.size, ud.typeStr)
        for hit in ud.hits:
            output += '\t%s %s\n' % (hit[1].strftime('%X'), hit[0])
        output += '\n'
    
    return output
    

# Create a text/plain message
