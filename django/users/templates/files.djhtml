{% extends "layout-new.djhtml" %}

{% block head %}

<style type="text/css">

.file-list .details {
    background:none repeat scroll 0 0 #3A576F;
    color:#CCC;
    padding:8px;
}
.file-list h3 {
    margin-bottom:0px;
}

</style>

{% endblock %}

{% block content %}

<div class="container-fluid">
    <div class="row-fluid">
        <div class="span2"></div>
        <div class="span8">
            <h2>{{  user.name }} Files ({{ masters|length }})</h2>

            <ul class="unstyled file-list">
                {% for master in masters %}
                <li class="item">
                    <h3>
                        <a href="{% url 'odaweb.views2.index' master.short_name  master.latest_revision %}">{{ master.project_name }}</a>
                        {% if master.latest_revision > 0 %}
                            <small>{{ master.latest_revision }} revisions</small>
                        {% endif %}
                    </h3>
                    <p class="details">{{ master.creation_date|date:"SHORT_DATE_FORMAT" }} {{ master.details }}</p>

                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>

{%  endblock %}