    window.comment = function(offset, comment) {
        // TODO: Save the comment
        console.debug("comment is \""+comment+ "\"");
        $.post("/odaweb/comment/{{odafile.uuid}}/"+offset, { comment: comment } );
    }

 	
	$(document).ready(function(){
		
		{% for flag in sectionFlagsInfo %}
		  $('.FLAG_{{flag.abbrev}}').popover({
		      placement: 'bottom',
		      delay: 0,
		      title: '{{flag.name}}',
		      content: '{{flag.desc}}',
		  });
     
		{% endfor %}

        /* ---------------------------------------------------------------------------------------------------------  *
         * ADDRESS SLIDER
         * ---------------------------------------------------------------------------------------------------------  */
        // set the slider address display text
        // NOTE: This function is triggered via updateSlider() in history.js as well
        function updateAddrDisplay(addr) {
            addrStr = addr.toString(16).toUpperCase();
            console.debug("updateAddrDisplay to %s", addrStr);
            while (addrStr.length < 8) addrStr = "0" + addrStr;
            $("#slider-address").text("0x" + addrStr);
        }

        // event handler for slider control
        function sliderHandler(addr) {

            // no need to set the slider position, that's already been done by the event
            updateAddrDisplay(addr);

            // Try to scroll to the address
            if ( !updateDisassembly(addr) )
            {
                // Isn't loaded. Try to load it
                scrollToAddr(addr);
            }
        }

        // setup slider
        $( "#slider" ).slider({
            change: function( event, ui ) { console.debug("slider change event"); updateAddrDisplay(ui.value); },
            slide: function( event, ui ) { console.debug("slider slide event"); updateAddrDisplay(ui.value); },
            stop: function( event, ui )  { console.debug("slider stop event"); sliderHandler(ui.value); },
            animate: true,
            min: {{ sectionsCodeStartAddr }},
            max: {{ sectionsCodeStopAddr }},
        });

        // set initial position
        updateAddrDisplay($("#slider").slider("value"));

        // remove border
        $(".ui-slider-horizontal").css('border', 0);
        $(".ui-slider-handle").removeClass('ui-corner-all');

        $("html").keypress(function(event) {
            if (String.fromCharCode(event.which) == 'g') {
                var strAddr = prompt("Go to address:");
                var addr = parseInt(strAddr, 16);
                console.debug("Setting slider to 0x%s", addr.toString(16));
                $("#slider").slider("value", addr );

                // Try to scroll to the address
                if ( !updateDisassembly(addr) )
                {
                    // Isn't loaded. Try to load it
                    scrollToAddr(addr);
                }
            }
        });
    });


</script>
{% endblock %}

{% block content %}

    <div id="slider" style="margin-bottom: 15px">
        <table id="slider-sections">
            <tr>
                {% for s in sectionsCode %}
                    <td bgcolor="{{s.color}}" style="border:1px solid #ffffff; width:{% widthratio s.size sectionsCodeAddrRange 100 %}%"></td>
                {% endfor %}
            </tr>
        </table>
    </div>
    <div id="slider-address" style="color:gray; font-family:monospace; float:right">0</div>


    <ul class="nav nav-tabs">
        <li class='active'><a data-toggle="tab" href="#assembly" id="assembly-tab-item">Assembly</a></li>
        <li><a data-toggle="tab" href="#sections" id="sections-tab-item">Sections</a></li>
        <li><a data-toggle="tab" href="#symbols" id="symbols-tab-item">Symbols</a></li>
        <li><a data-toggle="tab" href="#strings" id="strings-tab-item">Strings</a></li>
    </ul>
    
    <div id="myTabContent" class="tab-content"> <!--style="min-width: 500px;"-->
        
        <!--  ASSEMBLY TAB CONTENT -->
        <div class="active tab-pane" id="assembly">
        	<div class="alert alert-info" id="download-bar"><div class="btn"><a href="/odaweb/download/{{odafile.uuid}}?platformId={{platformId}}">Download</a></div></div>
			<div class="tabbed-scroll assembly" id="assembly-scroll">
	        <table id="listing">
	        <colgroup>
	        <col style="width:50px;" align="right" />
	        <col style="width:80px;" />
	        <col style="width:90px;" align="right" />
	        <col style="width:400px;" />
	        <col />
	        </colgroup>
	        {% include "listing.djhtml" %}
	        </table>
	    </div>
	   	</div>
        
        <!--  SECTIONS TAB CONTENT -->
        <div class="tab-pane" id="sections">
            <div class="tabbed-scroll" id="sections-content">
                <table class="blue-white-table">
                    <tr>
                        <th>Name</th>
                        <th>Size</th>
                        <th>VMA</th>
                        <th>Flags</th>
                        <th>Alignment</th>
                    </tr>
                    {% for s in sections %}
                        <tr class="{% cycle 'even' 'odd' %}">
                            <td>{{s.name}}</td>
                            <td align="right">{{s.size}}</td>   
                            <td align="right">0x{{s.vma|stringformat:'08x'}}</td>  
                            <td align="left">{% for flag in s.flags %}<span class="FLAG_{{flag.abbrev}}">{{flag.abbrev}}</span>&nbsp;{% endfor %}</td>
                            <td align="right">2**{{s.alignment}}</td>
                        </tr>
                    {% endfor %}
                </table>     
            </div>
        </div>
        
        <!--  SYMBOLS TAB CONTENT -->
        <div class="tab-pane" id="symbols">
            <div class="tabbed-scroll" id="symbols-content">
                <table class="blue-white-table"> 
                    <tr>
                        <th align="right">Address</th>
                        <th align="center">Type</th>
                        <th align="left">Name</th>
                    </tr>
                    {% for s in symbols %}
                        <tr class="{% cycle 'even' 'odd' %}">
                            <td align="right">0x{{s.value|stringformat:'08x'}}</td>  
                            <td align="center">{{s.type}}</td> 
                            <td align="left"><a href="#/view/assembly-tab-item/offset/{{s.value|stringformat:"08x"}}">{{s.name}}</a></td> 
                        </tr>
                    {% endfor %}
                </table>     
            </div>
        </div>
             
        <!--  STRINGS TAB CONTENT -->
        <div class="tab-pane" id="strings">
            <div class="tabbed-scroll" id="strings-content">
                    <table class="blue-white-table"> 
                    <tr>
                        <th align="right">Offset</th>
                        <th align="center">String</th>
                    </tr>
                    {% for addr,str in strings %}
                        <tr class="{% cycle 'even' 'odd' %}">
                            <td align="right">0x{{addr|stringformat:'08x'}}</td>  
                            <td align="left">{{str}}</td> 
                        </tr>
                    {% endfor %}
                </table>    
            </div>
        </div>            
    </div>
{% endblock %}
