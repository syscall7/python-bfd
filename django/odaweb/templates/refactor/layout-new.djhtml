<!DOCTYPE html>
<html>
<head>

    <title></title>
    <link rel="stylesheet" type="text/css" href="{{ STATIC_URL }}lib/bootstrap-2.2.2/css/bootstrap.min.css"/>
    <link rel="stylesheet" type="text/css" media="all" href="http://code.jquery.com/ui/1.10.0/themes/base/jquery-ui.css" />
    <link rel="stylesheet" type="text/css" href="{{ STATIC_URL }}css/oda2.css" />
    <script type="text/javascript" src="{{ STATIC_URL }}lib/jquery/jquery-1.8.3.min.js" ></script>
    <script type="text/javascript" src="{{ STATIC_URL }}lib/bootstrap-2.2.2/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/underscore-1.3.3.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/backbone-0.9.2.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/splitter.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/scroll-startstop.events.jquery.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/fixed-table.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/history.js"></script>
    <script src="http://code.jquery.com/ui/1.10.0/jquery-ui.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/app.js"></script>

    {% block head %}{% endblock %}

</head>
<body>

<img src="{{ STATIC_URL }}images/oda.png" style="position: absolute;"/>

<div class="navbar navbar-inverse navbar-static-top" >
    <div class="navbar-inner">

        <div class="container">
            <div class="nav-collapse collapse">
                <a class="brand" href="#">ODA</a>
                <ul class="nav">
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">File<b class="caret"></b></a>
                        <ul class="dropdown-menu">
                            <li><a class="nav-btn" data-panel="upload-display" href="#"><i class="icon-upload"></i>&nbsp;Upload</a></li>
                            <li><a href="#">Copy/Paste Hex</a></li>
                            <li class="divider"></li>
                            <li><a href="./_save"><i class="icon-share"></i>Save</a></li>
                            <li><a href="#">Download</a></li>
                        </ul>
                    </li>
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">Edit<b class="caret"></b></a>
                        <ul class="dropdown-menu">
                            <li><a href="#">Undo</a></li>
                            <li><a href="#">Redo</a></li>
                            <li class="divider"></li>
                            <li><a class="nav-btn"
                                   rel="tooltip"
                                   data-original-title="Platform Settings"
                                   data-panel="platform-display" href="#"><i class="icon-pencil"></i>&nbsp;Platform Options</a></li>
                            <li class="divider"></li>
                            <li><a href="#">Find</a></li>
                            <li><a href="#">Go to...</a></li>
                        </ul>
                    </li>
                    <li class="">
                        <a href="http://www.onlinedisassembler.com/blog/">Blog</a>
                    </li>   
                    <li class="">
                        <a href=mailto:admin@onlinedisassembler.com>Contact Us!</a>
                    </li>                    
                </ul>
            </div>
        </div>
    </div>
</div>

<div id="main-display">
    {% block content %}{% endblock %}

</div>


</body>
</html>