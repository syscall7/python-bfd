<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/html" xmlns="http://www.w3.org/1999/html">
<head>

    <title></title>
    <link rel="stylesheet" type="text/css" href="{{ STATIC_URL }}lib/bootstrap-2.2.2/css/bootstrap.min.css"/>
    <link rel="stylesheet" type="text/css" media="all" href="http://code.jquery.com/ui/1.10.0/themes/base/jquery-ui.css" />
    <link rel="stylesheet" type="text/css" href="{{ STATIC_URL }}css/oda2.css" />

    {% load compress %}
    {% compress js %}
    <script type="text/javascript" src="{{ STATIC_URL }}lib/jquery/jquery-1.8.3.min.js" ></script>
    <script type="text/javascript" src="{{ STATIC_URL }}lib/bootstrap-2.2.2/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/underscore-1.3.3.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/backbone-0.9.2.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/splitter.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/scroll-startstop.events.jquery.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/fixed-table.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/history.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/lib/jquery.form.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/app.js"></script>
    <script type="text/javascript" src="{{ STATIC_URL }}scripts/live-hex.js"></script>
    {%  endcompress %}
    <script src="http://code.jquery.com/ui/1.10.0/jquery-ui.js"></script>

    {% block head %}{% endblock %}

</head>
<body>


<img src="{{ STATIC_URL }}images/oda.png" width=40 height=40 style="position:absolute; padding-top: 4px; padding-left: 2px"/>
<div class="brand" style="color:#999; position:absolute; padding-top: 12px; padding-left: 45px">BETA</div>
<div class="navbar navbar-inverse navbar-static-top" >
    <div class="navbar-inner">

        <div class="container">
            <div class="nav-collapse collapse">
                <a class="brand" href="#">ODA</a>
                <ul class="nav">

                    <li class="">
                        <a href="/odaweb/_save"><i class="icon-share icon-white"></i>Share</a>
                    </li>

                    <!-- File Menu -->
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#" id="menu-item-file">File<b class="caret"></b></a>
                        <ul class="dropdown-menu">
                            <li class="dropdown-submenu"><a href="#" tab-index="-1"><i class="icon-file"></i>&nbsp;New</a>
                                <ul class="dropdown-menu">
                                    <li><a id="open-btn" href="_upload" data-toggle="modal"><i class="icon-upload"></i>&nbsp;Upload File...</a></li>
                                    <li><a href="/odaweb">Live Mode</a></li>
                                </ul>
                            </li>
                            <li class="dropdown-submenu"><a href="#" tab-index="-1"><i class="icon-folder-open"></i>&nbsp;Open Existing</a>
                                <ul id="open-existing-list" class="dropdown-menu">
                                    <li class="disabled"><a href="#">No files exist</a></li>
                                </ul>
                            </li>
                            <li class="divider"></li>
                            <li><a href="/odaweb/_save"><i class="icon-share"></i>Share</a></li>
                            <li><a href="#">Download</a></li>
                        </ul>
                    </li>

                    <!-- Edit Menu -->
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">Edit<b class="caret"></b></a>
                        <ul class="dropdown-menu">
                            <!--
                            <li><a href="#">Undo</a></li>
                            <li><a href="#">Redo</a></li>
                            <li class="divider"></li>
                            <li><a class="nav-btn"
                                   rel="tooltip"
                                   data-original-title="Platform Settings"
                                   data-panel="platform-display" href="#"><i class="icon-pencil"></i>&nbsp;Platform Options</a></li>
                            <li class="divider"></li>
                             -->
                            <li><a id="menu-go-to-addr" href="#">Go to address...</a></li>
                        </ul>
                    </li>

                    <!-- Examples Menu -->
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">Examples<b class="caret"></b></a>
                        <ul class="dropdown-menu">
                            <!-- TODO: Build this list dynamically -->
                            {% for example in examples %}
                                <li><a href="/odaweb/{{ example.short_name }}">{{ example.description }}</a></li>
                            {% endfor %}
                        </ul>
                    </li>
                    <li class="">
                        <a href="http://www.onlinedisassembler.com/blog/">Blog</a>
                    </li>   
                    <li class="">
                        <a href=mailto:admin@onlinedisassembler.com>Contact Us!</a>
                    </li>

                    <!-- Help Menu -->
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">Help<b class="caret"></b></a>
                        <ul class="dropdown-menu">
                            <li><a href="#">Quick Start Guide</a></li>
                            <li><a href="#">Tutorial</a></li>
                            <li class="divider"></li>
                            <li><a href="#">About</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div id="open-modal" class="modal hide fade"></div>

{% include "modal-share.djhtml" %}

{% include "modal-platform-options.djhtml" %}

<div id="modal-upload-form" class="modal hide fade">
{% include "modal-open.djhtml" %}
</div>

{% include "popover-inst-doc.djhtml" %}

<div id="main-display">
    {% block content %}{% endblock %}

</div>


</body>
</html>