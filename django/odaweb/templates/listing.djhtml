


{% for chunk in chunks %}
    {% for inst in chunk.instUnits %}

        {%  if inst.function %}
                <tr addr={{ inst.offset|stringformat:"08x" }}>
                    <td class="branchLines">{{ inst.branch_label|safe }}</td>
                    <td class="offset">{{inst.section_name}}:0x{{ inst.offset|stringformat:"08x" }}</td>
                    <td></td>
                    <td class="function" colspan="2">; =============== F U N C T I O N ====================================</td>
                </tr>
                
                {% for xref in inst.function.xrefs %}
                    <tr addr={{ inst.offset|stringformat:"08x" }}>
                        <td class="branchLines">{{ inst.branch_label|safe }}</td>
                        <td class="offset">{{inst.section_name}}:0x{{ inst.offset|stringformat:"08x" }}</td>
                        <td></td>
                        <td class="xref" colspan="2">; CODE XREF: <a href="#view/assembly-tab-item/offset/{{xref|stringformat:"08x"}}">0x{{xref|stringformat:"08x"}}</a></td>
                    </tr>                
                {%  endfor %}
                
        {% endif %}
        
        {%  if inst.labelName %}
                <tr addr={{ inst.offset|stringformat:"08x" }}>
                    <td class="branchLines">{{ inst.branch_label|safe }}</td>
                    <td class="offset">{{inst.section_name}}:0x{{ inst.offset|stringformat:"08x" }}</td>
                    <td></td>
                    <td class="insn"">{{ inst.labelName|safe }}:</td>
                </tr>
     
        {%  endif %}

                <tr addr={{ inst.offset|stringformat:"08x" }}>
                    <td class="branchLines">{{ inst.branch|safe }}</td>
                    <td class="offset">{{inst.section_name}}:0x{{ inst.offset|stringformat:"08x" }}</td>
                    <td class="raw" style="padding-left:10px;">{{ inst.rawBytes }}</td>
                    <td class="insn" style="padding-left:40px;">{{ inst.instStr|safe }}</td>
                    <td><span class="comment" contenteditable="true" style="color:blue; outline:none; width:250px; float:right; text-align:left;" >&nbsp;</span></td>
                </tr>

    {%  endfor %}
{%  endfor %}

