<table class="table table-striped sidebar-table" id="strings-table">
    <thead>
        <tr>
            <th align="center">Offset</th>
            <th align="center">String</th>
        </tr>
    </thead>
    <tbody class="scrollContent">
        {% for addr,str in strings %}
            <tr>
                <td class="str-offset" align="center">0x{{addr|stringformat:'08x'}}</td>
                <td class="string" align="center">{{str}}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% if not strings %}
    <em>No strings found</em>
{% endif %}