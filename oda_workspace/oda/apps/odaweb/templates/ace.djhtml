{% load staticfiles %}
{% load tags %}

<!DOCTYPE html>
<html lang="en">
<head>
<title>ACE in Action</title>

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/nprogress/nprogress.css' %}" />

<style type="text/css" media="screen">
    #editor {
        position: absolute;
        top: 20px;
        right: 0;
        bottom: 0;
        left: 0;
    }

    .branchLines {
        color: #093C83;
        text-align: right;
        width:50px;
        display:inline-block;
        overflow: hidden;
    }

    .raw {
        color: gray;
        width:100px;
        display: inline-block;
    }

        .instruction {
        color: #093C83;
    }

    .disassembly-cell {
        padding-right:10px;
    }

</style>
</head>
<body>

<div style="height:20px;"></div>

<div id="editor"></div>

<div style="right:23px;bottom:23px;position: absolute;" id="status-bar">
    apsdmpasomd
</div>

<script type="text/javascript" src="{% static 'scripts/lib/src-noconflict/ace.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/apf/apf_release.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/handlebars-v1.3.0.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/jquery/jquery-1.8.3.min.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/nprogress/nprogress.js' %}" ></script>
<script>

    $(document).ready(function(){

    NProgress.start();

    var editor = ace.edit("editor");
    editor.setTheme("ace/theme/eclipse");
    editor.getSession().setUseWorker(false);
    editor.setReadOnly(true);
    editor.getSession().setMode("ace/mode/javascript");
    editor.getSession().selection.addEventListener("changeCursor", function(event, source){

       /* var row = editor.getSession().doc.getLine(editor.selection.getCursor().row);
        var offset = JSON.parse(row).offset.toString(16);
        $('#status-bar').html(offset);
        console.log(editor.selection.getCursor(), offset);*/
    });

    var totalLoadedLines = 0;

    var loadMore = function(addr) {
        $.get('/odaweb/api/displayunits/', {
            short_name: 'chown',
            revision: 0,
            addr: addr,
            units: 500
        }).done(function(data){
            var lines = $.map(data, function(du) {return JSON.stringify(du)});
            editor.getSession().getDocument().insertLines(editor.getSession().getDocument().getLength()-1,lines)
            totalLoadedLines+=500;
            NProgress.set(totalLoadedLines/35000);
            if(data.length > 300) {
                loadMore(data[data.length-1].offset);
            }
        });
    };

    $.get('/odaweb/api/displayunits/', {
        short_name: 'chown',
        revision: 0,
        //addr:parseInt('401da4',16),
        units: 500

    }).done(function(data){



        var disassembly_text = '';
        var lines = $.map(data, function(du) {return JSON.stringify(du)});
        //for (var i=0; i<data.length; i++) {
        //    disassembly_text +=  + "\n";
            /*disassembly_text += data[i].branch +
                    '<span class="offset">' +data[i].offset + '<span>' +
                    data[i].section_name + ": " +  + " " + data[i].rawBytes + " " + data[i].instStr + "\n";
            */
            // disassembly_text += data[i].rawBytes + " ";
            // if ((i % 16) == 0 ) {
            //    disassembly_text += "\n";
            //}

        //}
        editor.getSession().getDocument().insertLines(0,lines)
        //editor.insert(disassembly_text);
        loadMore(data[data.length-1].offset);
        totalLoadedLines+=500;
        NProgress.set(totalLoadedLines/35000);
    });

    });

</script>
</body>
</html>