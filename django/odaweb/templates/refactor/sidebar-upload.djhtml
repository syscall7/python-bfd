<div id="upload-display"
     style="padding:5px; background-color: white;" class="item">
    <div class="sidebar-legend">Upload Binary</div>
    <form id="upload-form" class="sidebar-content form-inline"
          enctype="multipart/form-data"
          action="_upload" method="post">
        <fieldset>
            <label>File:</label>
            <input id="filename" type="text" class="input disabled" name="filename" readonly>
            <input type="file" id="file" name="filedata" style="display: none;">
            <a id="fileselectbutton" class="btn">Choose...</a>
        </fieldset>

        <div style="padding: 15px 5px 10px 95px;">
            <button id="file-upload-submit" type="submit" class="btn btn-primary">Disassemble</button>
        </div>

    </form>
</div>