{% extends "refactor/layout-new.djhtml" %}

{% load tags %}

{% block head %}

    <script type="text/javascript">
    $(document).ready(function(){

        // set the address range for the slider
        InitializeSlider({{ section_info.start_addr  }}, {{ section_info.stop_addr }})

        var binary = new Binary({
            id : '{{ binary.id }}',
            liveMode : {{ binary.is_live_mode|jsonify  }}
        });

        OdaApplication(binary);

    });
    </script>

{% endblock %}

{% block content %}



    {% include "refactor/sidebar.djhtml" %}

    <div id="view">
        <div id="view-container">
            <!--div id="slider-container"-->
                <div id="slider" style="margin-bottom: 15px; margin-top: 5px; border: 0px">
                    <table id="slider-sections">
                        <tr>
                            {% for s in section_info.code_sections %}
                                <td bgcolor="{%  sectioncolor forloop.counter0 %}"
                                    style="border:1px solid #ffffff; width:{% widthratio s.size section_info.addr_range  100 %}%"></td>
                            {% endfor %}
                        </tr>
                    </table>
                </div>
                <div id="slider-address" style="color:gray; font-family:monospace; float:right">0</div>
            <!--/div-->
            <ul class="nav nav-tabs" id="myTab" style="margin-bottom: 0px;">
                <li class="active"><a data-toggle="tab" href="#tab-assembly">Disassembly</a></li>
                <li class=""><a data-toggle="tab" href="#tab-hexdump">Hex Dump</a></li>
                <li class=""><a data-toggle="tab" href="#tab-sections">Sections</a></li>
                <li class=""><a data-toggle="tab" href="#tab-fileinfo">File Info</a></li>
                <!--<li class="dropdown">
                    <a data-toggle="dropdown" class="dropdown-toggle" href="#">Dropdown <b class="caret"></b></a>
                    <ul class="dropdown-menu">
                        <li><a data-toggle="tab" href="#dropdown1">@fat</a></li>
                        <li><a data-toggle="tab" href="#dropdown2">@mdo</a></li>
                    </ul>
                </li>-->
            </ul>
            <div class="tab-content" id="myTabContent">
                {% include "refactor/tab-disassembly.djhtml" %}
                {% include "refactor/tab-hexdump.djhtml" %}
                <div id="tab-sections" class="tab-pane fade"></div>
                <div id="tab-fileinfo" class="tab-pane fade"></div>
            </div>

        </div>

        <table id="status-bar">
            <tr>
                <td id="status-bar-left">
                </td>
                <td id="status-bar-right">
                    <a href="#" id="platform-option"> {{ binary.options.architecture }}</a>  | {{ binary.size|filesizeformat }} | {{ binary.name }}
                </td>
        </table>
    </div>
    <div id="vertSplitter" class="vsplitbar"></div>
{% endblock %}