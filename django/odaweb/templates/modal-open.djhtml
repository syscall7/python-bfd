<div id="modal-upload-form" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3>Open File</h3>
            </div>
            <div class="modal-body">
                <form id="upload-form" class="form-horizontal"
                      enctype="multipart/form-data"
                      action="_upload" method="post">

                    <div class="form-group">
                        <label for="projectName" class="col-sm-4 control-label">Project Name</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="projectName" placeholder="Project Name">
                        </div>
                    </div>

                   <div class="form-group">
                        <label for="filename" class="col-sm-4 control-label">File</label>
                        <div class="col-sm-8">
                            <input id="filename" type="text" class="input-medium disabled" name="filename" readonly>
                            <input type="file" id="file" name="filedata" style="display: none;">
                            <a id="fileselectbutton" class="btn add-on">Choose File...</a>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <a href="#" class="btn" data-dismiss="modal">Cancel</a>
                <a id="upload-submit-btn" href="#" class="btn btn-primary">Upload</a>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div><!-- /.modal -->