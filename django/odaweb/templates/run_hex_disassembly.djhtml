{% block scripts %}
<script type="text/javascript" src="{{ STATIC_URL }}scripts/comment.js"></script>
{% endblock %}

{% block content %}

    <div id="disassembly">
    {% autoescape off %}
        <table>
        <colgroup>
        <col style="width:32;" align="right"/>
        <col style="width:80px;" />
        <col style="width:90px;" align="right" />
        <col style="width:400px;" />
        <col />
        </colgroup>
        {% for chunk in chunks %}
            {% for inst in chunk.instUnits%}
                {%  if inst.labelName %}
                    <tr>
                        <td class="branchLines">{{ inst.branch_label }}</td>
                        <td class="offset">0x{{ inst.offset|stringformat:"08x" }}</td>
                        <td class="insn" style="padding-left:50px;"><span class="oda_label" contenteditable="true">{{ inst.labelName|safe }}</span>:</td>
                    </tr>

                {%  endif %}
    
                <tr addr={{ inst.offset|stringformat:"08x" }}>
                    <td class="branchLines">{{ inst.branch|safe }}</td>
    	            <td class="offset"><a name="{{ inst.offset|stringformat:"x" }}"></a>0x{{ inst.offset|stringformat:"08x" }}</td>
                    <td class="raw" style="padding-left:10px;">{{ inst.rawBytes }}</td>
                    <td class="insn">{{ inst.instStr|safe }}&nbsp;&nbsp;<span class="comment" contenteditable="true" style="color:blue; outline:none; width:250px; text-align:left;" >&nbsp;</span></td>
                </tr>

            {%  endfor %}
        {%  endfor %}
        </table>
    {%  endautoescape %}
    </div>
{% endblock %}
