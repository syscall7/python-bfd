{% load staticfiles %}
{% load tags %}

<!DOCTYPE html>
<html lang="en">
<head>
<title>ACE in Action</title>

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/nprogress/nprogress.css' %}" />

<style type="text/css" media="screen">
    #editor {
        position: absolute;
        top: 20px;
        right: 0;
        bottom: 0;
        left: 0;
    }

    .branchLines {
        color: #093C83;
        text-align: right;
        width:50px;
        display:inline-block;
        overflow: hidden;
    }

    .raw {
        color: gray;
        width:100px;
        display: inline-block;
    }

        .instruction {
        color: #093C83;
    }

    .disassembly-cell {
        padding-right:10px;
    }

</style>
</head>
<body>

<div style="height:20px;"></div>

<div id="editor"></div>

<div style="right:23px;bottom:23px;position: absolute;" id="status-bar">
    apsdmpasomd
</div>

<script type="text/javascript" src="{% static 'scripts/lib/src-noconflict/ace.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/apf/apf_release.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/handlebars-v1.3.0.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/jquery/jquery-1.8.3.min.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/nprogress/nprogress.js' %}" ></script>
<script>

    $(document).ready(function(){

        var document = ace.require('ace/document');

        var WindowLoader = function() {
            this.windowSize = 1000;

            this.load = function(rowNum, callback) {
                console.log("Loading...",rowNum);

                var tlines = [];
                for (var i=rowNum; i<rowNum + this.windowSize; i++) {

                    var line = '<div style="height:14px" class="ace_line"><span class="branchLines"> &nbsp;</span><span class="offset disassembly-cell">.interp:4194872</span><span class="raw disassembly-cell">2f</span><span class="instruction"><span class="string">/</span></span></div>'
                    var s = {"section_name":".text","offset":4233570,"rawBytes":"4889c7","instStr":"mov    rdi,rax","branch":"&#x2001;&#x2001;&nbsp;","branch_label":"&#x2001;&#x2001;&nbsp;","opcode":"mov","operands":"rdi,rax","stringRef":null,"branchRef":null,"targetRef":null,"crossRef":[],"isBranch":false,"isFunction":false,"labelName":"abc"}
                    tlines.push(JSON.stringify(s));
                }
                callback(new document.Window(rowNum, tlines));
            };

            this.getWindowSize = function() {
                return this.windowSize;
            }
        };


        NProgress.start();

        var doc = new document.OnlineDocument(8000000, new WindowLoader());
        doc.setLoadingString("..");
        var editor = ace.edit("editor", doc);
        editor.setTheme("ace/theme/chrome");
        //editor.setLineRenderer(lineRenderer);
        editor.getSession().setMode("ace/mode/javascript");
        editor.getSession().setUseWorker(false);
        editor.setShowPrintMargin(false);

    });

</script>
</body>
</html>