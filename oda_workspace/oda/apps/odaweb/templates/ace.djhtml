{% load staticfiles %}
{% load tags %}

<!DOCTYPE html>
<html lang="en">
<head>
<title>ACE in Action</title>

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/nprogress/nprogress.css' %}" />

    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.0.3/css/bootstrap.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/bootstrap-3.0.3/css/bootstrap-theme.css' %}"/>
    <link rel="stylesheet" type="text/css" href="{% static 'scripts/lib/font-awesome-4.0.3/css/font-awesome.css' %}" />

    <script type="text/javascript" src="{% static 'scripts/lib/jquery/jquery-1.8.3.min.js' %}" ></script>
    <script type="text/javascript" src="{% static 'scripts/lib/bootstrap-3.0.3/js/bootstrap.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery-ui-1.10.4.js' %}"></script>
    <script type="text/javascript" src="{% static 'scripts/lib/jquery.layout-rc30.79.js' %}"></script>

<style type="text/css" media="screen">
    body {
        margin: 0px;
    }
    #editor {
        width:100%;
    }
    .theeditor {
        position: absolute;
        top: 25px;
        right: 0;
        bottom: 20px;
        left: 0;
    }

    .ace_gutter-cell {
        text-align:left;
    }

    .branchLines {
        color: #093C83;
        text-align: right;
        width:49px;
        display:inline-block;
        overflow: hidden;
    }

    .raw {
        color: gray;
    }

    .instruction {
        color: #093C83;
    }

    .function-return {
        font-style: italic;
    }

    .function-name {
        font-weight: bold;
    }

     #statusBar {
        margin: 0;
        padding: 0;
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 20px;
        background-color: rgb(245, 245, 245);
        color: gray;
    }
    .ace_status-indicator {
        color: gray;
        position: absolute;
        right: 0;
        border-left: 1px solid;
    }



</style>
</head>
<body>

<div>
    <div id="slider" style="margin-bottom: 0px; margin-right: 15px; border: 0px;">
        <canvas id="addr-bar-canvas">You need to upgrade your browser to see this!</canvas>
    </div>
    <div style="color:gray; font-family:monospace; margin-right: 15px; float:right">0x0</div>
</div>

<div class="theeditor">
<div class="ui-layout-center">
    <div id="editor"></div>
</div>
<div class="ui-layout-west">West</div>
</div>

<div id="statusbar-container">
<div id="statusBar"><span class="status-mode">online disassembler forever!</span><div class="ace_status-indicator" style="display: inline-block;">61:0</div></div>
</div>




<div id="my-modal" class="modal fade">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4 class="modal-title">Comment Dialog</h4>
      </div>
      <div class="modal-body">
          <p class="commentLine"></p>
          <input class="comment-text" type="text" style="width:500px;"/>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Save changes</button>
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<script type="text/javascript" src="{% static 'scripts/lib/src-noconflict/ace.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/handlebars-v1.3.0.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/nprogress/nprogress.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/lib/underscore-1.3.3.js' %}"></script>
<script type="text/javascript" src="{% static 'scripts/addrbar.js' %}" ></script>
<script type="text/javascript" src="{% static 'scripts/oda_ace.js' %}" ></script>

</body>
</html>