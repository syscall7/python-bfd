class UploadDesc:
    def __init__(self, filename):

        # run the program 'file' on it
        self.typeStr = Popen(['file', '-b', filename], stdout=PIPE).communicate()[0]

        # extract the timestamp from the name
        timestamp = time.strptime(os.path.basename(filename), '%Y%m%d-%H%M%S')
        hit = (filename, datetime.fromtimestamp(time.mktime(timestamp)))
        self.hits = [hit]

        # size of upload
        self.size = os.stat(filename).st_size

        # md5
        self.md5 = hashlib.md5(open(filename, 'r').read()).hexdigest()

