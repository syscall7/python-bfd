<script type="text/javascript">
    $(document).ready(function(){

    {% for flag in sectionFlagsInfo %}
        $('.FLAG_{{ flag.abbrev }}').popover({
            placement: 'bottom',
            trigger: 'hover',
            delay: { show: 0, hide: 0 },
            title: '{{flag.name}}',
            content: '{{ flag.desc|escapejs }}'
        });

        $('.FLAG_{{ flag.abbrev }}').addClass('label');

        $('.FLAG_{{ flag.abbrev }}').addClass("{% cycle 'label-success' 'label-warning' 'label-important' 'label-info' 'label-inverse' %}");

    {% endfor %}

    });

</script>

<table class="blue-white-table">
    <tr>
        <th>Name</th>
        <th>Size</th>
        <th>VMA</th>
        <th>Flags</th>
        <th>Alignment</th>
    </tr>
    {% for s in sections %}
        <tr class="{% cycle 'even' 'odd' %}">
            <td>{{s.name}}</td>
            <td align="right">{{s.size|filesizeformat}}</td>
            <td align="right">0x{{s.vma|stringformat:'08x'}}</td>
            <td align="left">
                {% for flag in s.flags %}
                    <span class="FLAG_{{ flag.abbrev }}">
                        {{flag.abbrev}}
                    </span>&nbsp;
                {% endfor %}
            </td>
            <td align="right">2<sup>{{s.alignment}}</sup></td>
        </tr>
    {% endfor %}
</table>