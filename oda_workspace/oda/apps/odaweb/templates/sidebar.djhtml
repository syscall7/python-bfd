<div id="sidebar">
    <div id="sidebar-container" style="padding-left: 10px; padding-top: 5px;">

        <div role="toolbar" class="btn-toolbar pull-right" ng-controller="SidebarToolbarController">
          <div class="btn-group" ng-show="!oda_master.binary.liveMode">
            <button class="btn nav-btn btn-default" type="button" id="symbols-btn"
                    data-panel="symbols-display" data-toggle="tooltip" title="Symbols">
                <span class="glyphicon glyphicon-list"></span>
            </button>
            <button class="btn nav-btn btn-default" type="button" id="hex-display-btn" data-panel="hex-display">
                <span class="glyphicon glyphicon-asterisk"></span>
            </button>
            <button class="btn nav-btn btn-default" type="button" data-panel="strings-display"
                    data-toggle="tooltip" title="Strings">
                <span class="glyphicon glyphicon-font"></span>
            </button>
            <button id="sidebar-find-btn" class="btn nav-btn btn-default" type="button" data-panel="find-results-display" data-toggle="tooltip"
                   title="Find Results">
                <span class="glyphicon glyphicon-search"></span>
            </button>
            <button class="btn nav-btn btn-default" type="button" data-panel="structtypes-display"
                    data-toggle="tooltip" title="Struct Types">
                <span class="glyphicon glyphicon-text-width"></span>
            </button>
          </div>
        </div>

        <div id="sidebarContent">
            {% include 'sidebar-hex.djhtml' %}
        
            <div id="strings-display"
                 style="padding:5px; background-color:white;"
                 class="item">
                <div class="sidebar-legend">Strings</div>
                <div class="sidebar-content">
                    <div ng-include="'/static2/templates/strings.html'"
                         id="strings-content">
                    </div>
                </div>
            </div>

        
            <div id="symbols-display" style="padding:5px; background-color: white;" class="item">
                <div class="sidebar-legend">Symbols</div>
                <div class="sidebar-content">
                    <div ng-include="'/static2/templates/symbols.html'"
                         id="strings-content">
                    </div>
                </div>
            </div>

            <div id="find-results-display" style="padding:5px; background-color: white;" class="item">
                <div class="sidebar-legend">Find</div>
                <div class="sidebar-content">
                    <div ng-include="'/static2/templates/find_results.html'"
                         id="results-content">
                    </div>
                </div>
            </div>

            <div id="structtypes-display" style="padding:5px; background-color: white;" class="item">
                <div class="sidebar-legend">Structs</div>
                <div class="sidebar-content">
                    <div ng-include="'/static2/templates/struct_types.html'"
                         id="struct-types-content">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>