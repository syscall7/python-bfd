<table class="table table-striped sidebar-table" id="symbol-table">
    <thead>
        <tr>
            <th align="right">Address</th>
            <th align="center">Type</th>
            <th align="left">Name</th>
        </tr>
    </thead>
    <tbody class="scrollContent">
        {% for s in symbols %}
            <tr>
                <td align="right">0x{{s.value|stringformat:'08x'}}</td>
                <td align="center">{{s.type|stringformat:'c'}}</td>
                {% if s.type == 'T' or s.type == 't'  %}
                    <td align="left"><a href="#/view/tab-assembly-tab-item/offset/{{s.value|stringformat:"08x"}}">{{s.name}}</a></td>
                {% else  %}
                    <td align="left">{{s.name}}</td>
                {% endif %}

            </tr>
        {% endfor %}
    </tbody>
</table>

{% if not symbols %}
<em>No symbols available</em>
{% endif %}
