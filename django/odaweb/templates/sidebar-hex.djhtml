<div id="hex-display" style="padding:5px; background-color:white;" class="active item">


    <div class="sidebar-legend">Live View</div>

    <div class="alert alert-info">
        First, set the platform options below.  Then, watch the disassembly window update as you type hex bytes in the
        text area.  You can also upload an ELF, PE, COFF, Mach-O, or other executable file from the <em>File</em> menu.
    </div>


    <div class="accordion" id="accordion2">
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseTwo">
                    Platform Options: <span class="platform-option">{{ binary.options.architecture }}</span>
                </a>
            </div>
            <div id="collapseTwo" class="accordion-body collapse">
                <div class="accordion-inner">
                    <form>

                        <select class="platformSelect" id="select-live-architecture" name="select-live-architecture">
                            {% for a in supported_archs %}
                                <option
                                        {% if a == binary.options.architecture %}selected="selected"{% endif %}>
                                    {{a}}</option>
                            {% endfor %}
                        </select>

                        <div id="platform-options">
                            {% include 'show_options.djhtml' %}
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="alert" id="hex-alert" style="display:none;">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Warning!</strong> You can only disassemble hexadecimal characters, check your inputs.
    </div>

    <div id="hex-sidebar-scroll" class="sidebar-content">
        <textarea class="sidebar-scroll-container" id="hex"
                  style="width:95%; margin-bottom: 5px;" data-bind="value: hex">{% if binary.is_live_mode %}{{ binary.binary_string_display }}{%  endif %}

        </textarea>
    </div>
</div>