{% for chunk in chunks %}
    <tbody>
    {% for inst in chunk.instUnits %}

        {%  if inst.function %}
                <tr addr={{ inst.offset|stringformat:"08x" }}>
                    <td class="branchLines">{{ inst.branch_label|safe }}</td>
                    <td class="offset">{{inst.section_name}}:0x{{ inst.offset|stringformat:"08x" }}</td>
                    <td></td>
                    <td class="function" style="width:100%;">; =============== F U N C T I O N ====================================</td>
                </tr>
                
                {% for xref in inst.function.xrefs %}
                    <tr addr={{ inst.offset|stringformat:"08x" }}>
                        <td class="branchLines">{{ inst.branch_label|safe }}</td>
                        <td class="offset">{{inst.section_name}}:0x{{ inst.offset|stringformat:"08x" }}</td>
                        <td></td>
                        <td class="xref" colspan="2">; CODE XREF: <a href="#view/tab-assembly/offset/{{xref|stringformat:"08x"}}">0x{{xref|stringformat:"08x"}}</a></td>
                    </tr>                
                {%  endfor %}
                
        {% endif %}
        
        {%  if inst.labelName %}
                <tr addr={{ inst.offset|stringformat:"08x" }}>
                    <td class="branchLines">{{ inst.branch_label|safe }}</td>
                    <td class="offset">{{inst.section_name}}:0x{{ inst.offset|stringformat:"08x" }}</td>
                    <td></td>
                    <td><span class="oda_label" contenteditable="true">{{ inst.labelName|safe }}</span>:</td>
                </tr>
     
        {%  endif %}

                <tr addr={{ inst.offset|stringformat:"08x" }}>
                    <td class="branchLines">{{ inst.branch|safe }}</td>
                    <td class="offset">{{inst.section_name}}:0x{{ inst.offset|stringformat:"08x" }}</td>
                    <td class="raw" style="padding-left:10px;">{{ inst.rawBytes }}</td>
                    <td style="padding-left:40px;"><insn>{{ inst.instStr|safe }}</insn>&nbsp;&nbsp;<span class="comment" contenteditable="true" style="color:blue; outline:none; width:250px; text-align:left;" >&nbsp;{{ inst.comment|safe }}</span></td>
                </tr>

    {%  endfor %}
    </tbody>
{%  endfor %}

