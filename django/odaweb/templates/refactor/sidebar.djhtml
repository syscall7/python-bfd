<div id="sidebar">
    <div id="sidebar-container">
        <div id="sidebar-tools" class="btn-toolbar pull-right">
            <div class="btn-group">
                <a class="btn nav-btn"
                   data-panel="symbols-display"
                   data-toggle="tooltip"
                   title="Symbols"
                   id="symbols-btn"
                   href="#">
                    <i class="icon-list"></i>
                </a>
                <a class="btn nav-btn"
                   data-panel="hex-display"
                   data-toggle="tooltip"
                   title="Raw Bytes"
                   id="hex-display-btn"
                   href="#"><i class="icon-asterisk"></i>
                </a>
                <a class="btn nav-btn" data-panel="strings-display"
                   data-toggle="tooltip"
                   title="Strings"
                   href="#">
                    <i class="icon-font"></i>
                </a>
            </div>
        </div>

        <div id="sidebarContent">
            {% include 'refactor/sidebar-hex.djhtml' %}
        
            {% include "refactor/sidebar-strings.djhtml" %}
        
            {% include "refactor/sidebar-platform-options.djhtml" %}
        
            {% include "refactor/sidebar-symbols.djhtml" %}
        </div>
    </div>
</div>