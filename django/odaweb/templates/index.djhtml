{% extends "layout-new.djhtml" %}

{% load tags %}

{% block head %}

    <script type="text/javascript">

    window.oda_master = {
        short_name : '{{master.short_name }}',
        content_type : '{{ master.content_type.id }}',
        object_id : {{ master.object_id }},
        revision : {{ master.revision | jsonify}}
    };

    window.user = {
        username : '{% if not user.is_authenticated %}anonymous{% else %}{{ user.username }}{% endif %}'
    };

    window.socket = io.connect("http://" + window.location.hostname + ":8080");

    $(document).ready(function(){

        // set the address range for the slider
        InitializeSlider({{ section_info.start_addr  }}, {{ section_info.stop_addr }})

        var binary = new Binary({
            id : '{{ binary.id }}',
            liveMode : {{ binary.is_live_mode|jsonify  }},
            arch : '{{ arch }}'
        });

        OdaApplication({
            binary : binary,
            saved : {{ saved|jsonify }}
        });


    });
    </script>

{% endblock %}

{% block content %}

    {% include "sidebar.djhtml" %}

    <div id="view">
        <div id="view-container">
            <div ng-include="'/static2/templates/slider.html'">

            </div>
            <ul class="nav nav-pills" id="myTab" style="margin-bottom: 15px;">
                <li class="active"><a data-toggle="tab" href="#tab-assembly">Disassembly</a></li>
                <li class=""><a data-toggle="tab" href="#tab-hexdump">Hex Dump</a></li>
                <li class=""><a data-toggle="tab" href="#tab-sections">Sections</a></li>
                <li class=""><a data-toggle="tab" href="#tab-fileinfo">File Info</a></li>
                <!--<li class="dropdown">
                    <a data-toggle="dropdown" class="dropdown-toggle" href="#">Dropdown <b class="caret"></b></a>
                    <ul class="dropdown-menu">
                        <li><a data-toggle="tab" href="#dropdown1">@fat</a></li>
                        <li><a data-toggle="tab" href="#dropdown2">@mdo</a></li>
                    </ul>
                </li>-->
            </ul>
            <div class="tab-content" id="myTabContent">
                <div id="tab-assembly" class="tab-pane active in" ng-include="'/static2/templates/disassembly.html'">

                </div>
                {% include "tab-hexdump.djhtml" %}
                <div id="tab-sections" class="tab-pane fade"
                     ng-inc99lude="'/static2/templates/sections.html'"></div>
                <div id="tab-fileinfo" class="tab-pane fade">
                    {% include "tab_fileinfo.djhtml" %}
                </div>
            </div>

        </div>

        <table id="status-bar">
            <tr>
                <td id="status-bar-left">
                </td>
                <td id="status-bar-right">
                    <a href="#" class="platform-option"> {{ binary.options.architecture }}</a>  | {{ binary.size|filesizeformat }} | {{ project_name }}
                </td>
        </table>
    </div>
    <div id="vertSplitter" class="vsplitbar"></div>
{% endblock %}