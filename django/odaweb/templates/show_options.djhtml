<div>
    <label class="control-label upload-form-control" for="endianSelect">Endian</label>
    <select class="span2" id="endianSelect" name="normalSelect">
        {% for k,v in supported_endians.iteritems %}
            <option value="{{v}}">{{k}}</option>
        {% endfor %}
    </select>
</div>
{% for widgetName, widget, title, desc, unused, opts in options %}
    {% if widget == "select" %}
        <div style="clear:both;">
            <label class="control-label upload-form-control" for={{widgetName}}>{{title}}</label>
            <select class="span2" id={{widgetName}} name="normalSelect">
            {% for opt in opts %}
                <option value="{{opt}}">{{opt}}</option>
            {% endfor %}
            </select>
        </div>
    {% endif %}
{% endfor %}