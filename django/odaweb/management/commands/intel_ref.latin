                                                                  Disabled
                             Init                                 EN = 0                 Illegal
                                                  EN =1           Extd = 0                   Transition
                                                                                                 Extd = 1

                                                    EN = 0                    Illegal
                                xAPIC Mode                     EN = 0
                                                              Extd = 0        Transition                    Invalid
                                EN=1, Extd=0
